// ==============================================================
// Ad-Arch Group OS — Prisma スキーマ
// Phase 2: コアモジュール（Branch / User / Customer / Deal）
//
// 【マルチテナント設計の原則】
//   - 全業務データは必ず Branch（拠点）に紐づく
//   - ADMIN（本部）: branchId = null → 全拠点データにアクセス可
//   - MANAGER/USER : branchId あり → 自拠点データのみアクセス可
//   - クエリ側で WHERE branchId = user.branchId を付与してスコープを絞る
// ==============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==============================================================
// Enums
// ==============================================================

enum Role {
  ADMIN // 本部: 全拠点・全データ フルアクセス
  MANAGER // 代表: 自拠点の財務・売上・全実務ツール
  USER // 一般社員: 実務ツールのみ / 財務データアクセス不可
}

enum DealStatus {
  PROSPECTING // 見込み
  QUALIFYING // 検討中
  PROPOSAL // 提案中
  NEGOTIATION // 交渉中
  CLOSED_WON // 受注
  CLOSED_LOST // 失注
  DORMANT // 休眠
  DEFERRED // 保留
}

enum ActivityType {
  CALL // 電話
  EMAIL // メール
  VISIT // 訪問
  MEETING // Web会議
  OTHER // その他
  SYSTEM // システム自動ログ（顧客情報変更など）
}

enum CustomerRank {
  A // 重要
  B // 通常
  C // 見込み
  D // 以後取引回避
}

enum CustomerStatus {
  PROSPECT // 見込み
  ACTIVE // 取引中
  INACTIVE // 休眠
  BLOCKED // 取引回避
}

enum ProjectStatus {
  ORDERED // 受注済み
  IN_PROGRESS // 進行中
  COMPLETED // 完了
  ON_HOLD // 保留
  CANCELLED // キャンセル
}

enum ExpenseCategory {
  LABOR // 人件費
  MATERIAL // 材料費
  SUBCONTRACT // 外注費
  TRANSPORT // 交通・運送費
  COMMUNICATION // 通信費
  OTHER // その他
}

enum ProjectLogType {
  SYSTEM // システム自動ログ（フィールド変更）
  NOTE // 手動メモ
  MEETING // 商談・会議ログ
  EXPENSE_ADDED // 経費追加
  EXPENSE_DELETED // 経費削除
}

enum LeadStatus {
  UNTOUCHED // 未対応
  CALLED // 架電済み
  APPOINTMENT // アポ獲得
  DEAL_CONVERTED // 商談化
  SKIPPED // スキップ
  CRAWLED // クロール済（未判定。TVCM/動画PR専用）
  ARCHIVED // アーカイブ（30日以上動きなしのフォロー待ちを自動移動）
}

enum BillingStatus {
  UNBILLED // 未請求
  BILLED // 請求済み
  PAID // 入金済み
}

enum SuspendReason {
  MONTHLY_REPORT // 月次報告未提出
  ROYALTY_UNPAID // ロイヤリティ未払い
  OTHER // その他（手動）
}

enum InvoiceRequestStatus {
  DRAFT // 未提出
  SUBMITTED // 提出済
}

enum EntityType {
  CORPORATION // 法人（株式会社・合同会社等）
  SOLE_PROPRIETOR // 個人事業主
  UNKNOWN // 未確認
}

enum BankAccountType {
  SAVINGS // 普通
  CHECKING // 当座
}

enum PaymentStatus {
  UNPAID // 未払い
  PAID // 支払済み
}

enum PaymentStatementStatus {
  DRAFT // 下書き
  CONFIRMED // 確定（パートナーに公開）
  PAID // 支払済み
}

enum GroupInvoiceType {
  ROYALTY // 月額ロイヤリティ（最低保証 max(5万, 案件10%手数料) の差額請求）
  MEMBERSHIP // 加盟参画費用
  OTHER // その他
}

enum GroupInvoiceStatus {
  DRAFT // 下書き
  ISSUED // 発行済み（パートナーに公開）
  PAID // 入金済み
}

enum EstimationStatus {
  DRAFT // 下書き（未発行・通知なし）
  ISSUED // 発行済み（通知送信済み）
  SENT // 送付済み（顧客に送付）
  ACCEPTED // 承認済み
  REJECTED // 却下
}

enum CollaborationRequestType {
  SHOOTING_SUPPORT // 撮影支援
  EDITING_RESOURCE // 編集リソース協力
  EQUIPMENT_CAST // 機材・キャスト手配
  KNOWLEDGE_SHARING // 知見共有・相談
  PROXY_VISIT // クライアント別拠点の代理視察及び営業
  OTHER // その他
}

enum CollaborationStatus {
  PENDING // 未対応
  REVIEWING // 検討中
  ACCEPTED // 受諾
  DECLINED // 辞退
  COMPLETED // 完了
}

enum MediaType {
  TVER // TVer
  CINE_AD // シネアド（イオンシネマ）
  DIGITAL_SIGNAGE // デジタルサイネージ
  TAXI // タクシー広告
  APA_HOTEL // アパホテル
  UNIVERSITY // 大学広告
  SKYLARK // すかいらーく広告
  GOLF_CART // ゴルフカート
  ACQUISITION // 取得依頼
  OTHER // その他
}

enum MediaRequestStatus {
  PENDING // 依頼中
  REVIEWING // 確認中
  COMPLETED // 完了
  CANCELLED // キャンセル
}

enum AdvertiserReviewStatus {
  PENDING // 審査中（デフォルト）
  APPROVED // 承認
  REJECTED // 否決
}

enum TverCampaignBudgetType {
  TOTAL // 期間予算
  MONTHLY // 月次予算（毎月1日更新）
}

enum TverFrequencyCapUnit {
  LIFETIME // 全期間
  WEEKLY // 1週間
  DAILY // 1日
  HOURLY // 1時間
}

enum TverCompanionMobile {
  NONE // 利用しない
  BANNER // バナー
  ICON_TEXT // アイコン/テキスト
  TEXT // テキスト
}

enum TverCompanionPc {
  NONE // 利用しない
  BANNER // バナー
}

enum TverGenderTarget {
  ALL // 全性別
  MALE // 男性
  FEMALE // 女性
}

enum DisclosureStatus {
  PENDING // 申請中
  APPROVED // 承認
  REJECTED // 却下
}

enum TverCampaignStatus {
  DRAFT // 下書き
  SUBMITTED // 申請済み
  APPROVED // 承認
  REJECTED // 否決
}

enum LeadSource {
  GOOGLE_PLACES
  GBIZINFO
  CINEMA_AD
  RECRUIT_SEARCH
  CSV_IMPORT
  MANUAL
  SIGNBOARD_SCAN
  PR_TIMES_TVCM
  VIDEO_ACHIEVEMENT
}

enum AutoSalesTargetType {
  BTOB // 法人向け
  BTOC // 個人・店舗向け
}

enum AutoSalesServiceType {
  VIDEO_PRODUCTION // 動画制作
  SNS_MANAGEMENT // SNS運用
  AD_MEDIA // 広告媒体提案
  FIRST_MEETING // 初回商談（とりあえず会いたい）
}

enum AutoSalesJobStatus {
  QUEUED // キュー待ち
  PROCESSING // 実行中
  COMPLETED // 送信完了
  FAILED // 失敗（エラー）
  SKIPPED // スキップ（CAPTCHA等）
  DRY_RUN // ドライラン（送信せず確認用）
}

// ==============================================================
// Branch（拠点）
// ==============================================================

/// Ad-Arch グループの各加盟拠点を表すマスタテーブル。
/// 全業務データはこの Branch に紐づくことで、
/// テナント（拠点）ごとにデータが分離される。
model Branch {
  id       String  @id @default(cuid())
  name     String // 拠点名（例: 東京支社、大阪支店）
  code     String  @unique // 拠点コード・英数字（例: TKY, OSK）
  address  String? // 住所
  isActive Boolean @default(true) // 無効化フラグ

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                 User[]                      @relation("PrimaryBranch")
  users2                User[]                      @relation("SecondaryBranch")
  customers             Customer[]
  deals                 Deal[]
  projects              Project[]
  expenses              Expense[]
  wikiArticles          WikiArticle[]
  revenueReports        RevenueReport[]
  invoiceRequests       InvoiceRequest[]
  estimations           Estimation[]
  collaborationRequests GroupCollaborationRequest[]
  mediaRequests         MediaRequest[]
  advertiserReviews     AdvertiserReview[]
  tverCampaigns         TverCampaign[]
  tverCreativeReviews   TverCreativeReview[]

  // Studio
  studioClients       StudioClient[]       @relation("StudioClients")
  studioProductions   Production[]         @relation("StudioProductions")
  studioResults       MonthlyResult[]      @relation("StudioResults")
  snsFormatOrders     SnsFormatOrder[]     @relation("SnsFormatOrders")
  snsReferenceFormats SnsReferenceFormat[] @relation("SnsReferenceFormats")

  // AutoSales
  autoSalesTemplates AutoSalesTemplate[]
  autoSalesTargets   AutoSalesTarget[]

  @@map("branches")
}

// ==============================================================
// User（ユーザー）
// ==============================================================

/// システムの利用者。Google Workspace SSO でログインする。
/// 本部（ADMIN）が role と branchId を手動で割り当てる。
///
/// 【branchId の意味】
///   null  → ADMIN（本部）→ 全拠点データにアクセス可能
///   値あり → MANAGER / USER → その拠点のデータのみアクセス可能
model User {
  id    String  @id @default(cuid())
  email String  @unique // Google Workspace のメールアドレス
  name  String? // 表示名
  image String? // プロフィール画像 URL

  role      Role    @default(MANAGER)
  // ■ branchId = null → 本部（ADMIN）→ WHERE 句なしで全拠点アクセス
  // ■ branchId あり   → 拠点スコープ → WHERE branchId IN (branchId, branchId2)
  branchId  String?
  branchId2 String? // 第2担当拠点（複数拠点担当の場合）
  branch    Branch? @relation("PrimaryBranch", fields: [branchId], references: [id])
  branch2   Branch? @relation("SecondaryBranch", fields: [branchId2], references: [id])

  isActive      Boolean        @default(true) // 本部がアカウントを有効/無効管理
  suspendCount  Int            @default(0) // 累計停止回数
  suspendReason SuspendReason? // 停止理由（MONTHLY_REPORT / ROYALTY_UNPAID / OTHER）

  // ADMINが個別に許可するオプション機能（例: "cutsheet", "proposals"）
  enabledFeatures String[] @default([])

  // ラーニング資格免除フラグ（既存加盟者は true / 新規加盟者はテスト合格が必要）
  learningExempt Boolean @default(false)

  chatSpaceId String? // Google Chat 個人スペースID

  // ---- 通知設定 ----
  notifyViaChat  Boolean @default(false) // アプリ内通知をGoogle Chatにも転送
  notifyViaEmail Boolean @default(false) // アプリ内通知をメールにも転送

  // ---- グループ企業紐付け（メンバープロフィール用）----
  groupCompanyId String?
  groupCompany   GroupCompany? @relation("UserGroupCompany", fields: [groupCompanyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assignedDeals               Deal[]                      @relation("AssignedTo")
  createdDeals                Deal[]                      @relation("CreatedBy")
  lockedCustomers             Customer[]                  @relation("LockedBy") // 先着ロック中の顧客
  revenueReports              RevenueReport[]
  invoiceRequests             InvoiceRequest[]
  paymentStatements           PaymentStatement[]
  groupInvoices               GroupInvoice[]
  collaborationRequests       GroupCollaborationRequest[]
  mediaRequests               MediaRequest[]
  createdAdvertiserReviews    AdvertiserReview[]          @relation("CreatedAdvertiserReview")
  reviewedAdvertiserReviews   AdvertiserReview[]          @relation("ReviewedAdvertiserReview")
  tverCampaigns               TverCampaign[]
  tverCreativeReviews         TverCreativeReview[]
  reviewedTverCreativeReviews TverCreativeReview[]        @relation("ReviewedTverCreativeReview")
  videoAchievements           VideoAchievement[]          @relation("VideoAchievementCreatedBy")

  // ---- 名刺管理 ----
  ownedBusinessCards         BusinessCard[]      @relation("OwnedBusinessCards")
  disclosureRequestsSent     DisclosureRequest[] @relation("DisclosureRequester")
  disclosureRequestsReviewed DisclosureRequest[] @relation("DisclosureReviewer")

  // ---- 案件マッチング ----
  postedProjectRequests ProjectRequest[]     @relation("PostedRequests")
  projectApplications   ProjectApplication[] @relation("Applications")

  // ---- リード管理 ----
  assignedLeads   Lead[]           @relation("LeadAssignee")
  createdLeads    Lead[]           @relation("LeadCreatedBy")
  outreachSamples OutreachSample[] @relation("UserOutreachSamples")

  // ---- 提案書AI ----
  salesActivities SalesActivity[] @relation("SalesActivities")
  proposals       Proposal[]      @relation("Proposals")
  salesApproaches SalesApproach[] @relation("SalesApproachAuthor")

  // ---- ヘルプチャットボット ----
  chatbotConversations ChatbotConversation[] @relation("ChatbotConversations")

  // ---- Studio（制作OS）----
  studioClientsCreated StudioClient[]       @relation("StudioClientCreator")
  productionsCreated   Production[]         @relation("ProductionCreator")
  snsFormatOrders      SnsFormatOrder[]     @relation("SnsFormatOrderCreator")
  snsReferenceFormats  SnsReferenceFormat[] @relation("SnsReferenceFormatCreator")

  // ---- ラーニングシステム ----
  learningEnrollments LearningEnrollment[]
  learningProgress    LearningProgress[]
  learningAttempts    LearningAttempt[]

  // ---- アプリ内通知 ----
  notifications Notification[]

  // ---- お気に入り（ピン留め）----
  favorites UserFavorite[]

  // ---- 映像チェッカー（検収メンバー）----
  reviewMemberships ReviewProjectMember[]

  @@index([branchId])
  @@index([branchId2])
  @@index([role])
  @@index([groupCompanyId])
  @@map("users")
}

// ==============================================================
// Customer（顧客）
// ==============================================================

/// 顧客（企業）情報を管理する CRM テーブル。
/// 必ず Branch に紐づき、拠点をまたいだ参照は ADMIN のみ可能。
///
/// 【先着優先ロック機能】
///   営業担当が「担当する」ボタンを押すと lockedBy に記録され、
///   他の営業は lockExpiresAt まで同一顧客への新規商談作成を制限される。
model Customer {
  id              String         @id @default(cuid())
  recordNumber    Int            @unique @default(autoincrement()) // kintone 互換の通し番号
  name            String // 顧客名（法人名）
  nameKana        String? // ふりがな（検索用）
  corporateNumber String?        @db.VarChar(13) // 法人番号（13桁）
  contactName     String? // 担当者名
  email           String? // 担当者メールアドレス
  phone           String? // 電話番号
  website         String? // 公式サイト URL
  industry        String? // 業種
  source          String? // 流入経路
  rank            CustomerRank   @default(B) // 顧客ランク A〜D
  status          CustomerStatus @default(PROSPECT) // 取引ステータス
  postalCode      String?        @db.VarChar(8) // 郵便番号（例: 100-0001）
  prefecture      String? // 都道府県
  address         String? // 住所（番地）
  building        String? // ビル名・部屋番号
  notes           String?        @db.Text // 備考・メモ
  staffName       String? // 社内担当者名（登録者）

  // ---- 先着優先ロック -------------------------------------------
  // ロック中は他の営業担当者が新規商談を作成できない
  lockedByUserId String?
  lockedBy       User?     @relation("LockedBy", fields: [lockedByUserId], references: [id])
  lockedAt       DateTime? // ロック開始日時
  lockExpiresAt  DateTime? // ロック期限（デフォルト: ロックから30分後）

  // ---- マルチテナント（必須）------------------------------------
  // 全顧客データは必ず拠点に紐づく。branchId なしでは登録不可。
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  deals           Deal[]
  activityLogs    ActivityLog[]
  projects        Project[]
  invoiceRequests InvoiceRequest[]
  estimations     Estimation[]
  mediaRequests   MediaRequest[]
  salesApproaches SalesApproach[]  @relation("SalesApproachCustomer")

  // ---- リード管理 ----
  convertedFromLead Lead? @relation("LeadConvertedCustomer")

  // ---- ヒアリングシート ----
  hearingSheets HearingSheet[] @relation("CustomerHearingSheets")

  // ---- Studio（制作OS）----
  studioClients StudioClient[] @relation("StudioCustomer")

  @@index([branchId])
  @@index([lockedByUserId])
  @@index([name]) // 顧客名検索
  @@map("customers")
}

// ==============================================================
// ActivityLog（活動履歴）
// ==============================================================

/// 営業活動の記録。電話・メール・訪問・Web会議などを時系列で管理する。
model ActivityLog {
  id        String       @id @default(cuid())
  type      ActivityType @default(OTHER)
  content   String       @db.Text // 活動内容
  staffName String // 記録者名（ログイン名から自動取得）

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ==============================================================
// Deal（商談）
// ==============================================================

/// 商談（案件）情報を管理する SFA テーブル。
/// Customer と Branch の両方に紐づく。
///
/// 【branchId の非正規化について】
///   Customer.branchId と同値を持つが、あえてここにも持たせる。
///   理由: 拠点フィルタリングのクエリを Customer JOIN なしで実行できるようにするため。
model Deal {
  id                String     @id @default(cuid())
  title             String // 商談タイトル（例: ○○ビル 外壁改修工事）
  amount            Decimal?   @db.Decimal(15, 0) // 見積金額（円）
  status            DealStatus @default(PROSPECTING)
  probability       Int? // 受注確度 0〜100（%）
  expectedCloseDate DateTime? // 受注予定日
  closedAt          DateTime? // 実際の受注/失注日
  notes             String?    @db.Text // 商談メモ・経緯
  // 受注時の決め手（AIアシスタントの成功事例学習に使用）
  closingFactor     String?    @db.Text // 受注の決め手（文面・提案内容・関係性など）

  // ---- レギュラー（継続）案件 ----------------------------------
  isRegular            Boolean   @default(false) // レギュラー（毎月継続）案件か
  regularMonthlyAmount Decimal?  @db.Decimal(15, 0) // 月額（税抜・固定収入/MRR）
  regularStartDate     DateTime? // レギュラー開始日
  regularEndedAt       DateTime? // 解約日（null=継続中）
  regularRenewalDate   DateTime? // 次回更新日（更新管理・解約リスク検知）

  // ---- 担当者 --------------------------------------------------
  assignedToId String? // 主担当営業
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id])

  createdById String? // 商談作成者
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])

  // ---- 顧客との紐づき ------------------------------------------
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // ---- マルチテナント（必須・非正規化）--------------------------
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  dealLogs      DealLog[]
  hearingSheet  HearingSheet?
  decisionSheet DecisionSheet?
  project       Project?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([assignedToId])
  @@index([customerId])
  @@index([status])
  @@index([expectedCloseDate])
  @@map("deals")
}

// ==============================================================
// DealLog（商談活動ログ）
// ==============================================================

/// 商談単位の活動ログ。
/// ActivityLog が Customer 紐づきであるのに対し、こちらは Deal 紐づき。
model DealLog {
  id        String       @id @default(cuid())
  type      ActivityType @default(OTHER)
  content   String       @db.Text
  staffName String

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([dealId])
  @@index([createdAt])
  @@map("deal_logs")
}

// ==============================================================
// Project（プロジェクト）
// ==============================================================

/// 受注後の案件進行を管理するプロジェクト管理テーブル。
/// 商談（Deal）から受注に至った後、実務進行フェーズを管理する。
/// Customer（顧客）と Branch（拠点）の両方に紐づく。
model Project {
  id          String        @id @default(cuid())
  title       String // プロジェクト名
  status      ProjectStatus @default(IN_PROGRESS)
  deadline    DateTime? // 納期
  budget      Decimal?      @db.Decimal(15, 0) // 予算（円）
  description String?       @db.Text // 概要・説明
  staffName   String? // 担当者名（登録者）

  // ---- 商談との紐づき（受注時に自動作成）------------------------------
  dealId String? @unique
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  // ---- 顧客との紐づき（任意: 顧客未確定のプロジェクトも可）----------
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // ---- マルチテナント（必須）----------------------------------------
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billingStatus BillingStatus @default(UNBILLED) // 請求ステータス

  // Relations
  expenses              Expense[]
  logs                  ProjectLog[]
  invoiceRequests       InvoiceRequest[]
  estimations           Estimation[]
  collaborationRequests GroupCollaborationRequest[]
  reviewProjects        ReviewProject[]

  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([deadline])
  // 複合インデックス: 拠点別 + 最新順（一覧取得の主要クエリ）
  @@index([branchId, createdAt(sort: Desc)])
  // 複合インデックス: 拠点別 + ステータス絞り込み
  @@index([branchId, status])
  @@map("projects")
}

// ==============================================================
// Expense（経費）
// ==============================================================

/// プロジェクトに紐づく経費記録。
/// 予算と経費の差分から利益を自動計算する。
model Expense {
  id        String          @id @default(cuid())
  title     String // 経費名・内容
  amount    Decimal         @db.Decimal(15, 0) // 金額（円）
  category  ExpenseCategory @default(OTHER)
  date      DateTime        @default(now()) // 発生日
  notes     String?         @db.Text // 備考
  staffName String? // 記録者

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([branchId])
  @@index([date])
  @@map("expenses")
}

// ==============================================================
// ProjectLog（プロジェクトログ）
// ==============================================================

/// プロジェクトの変更履歴・メモ。
/// SYSTEM: フィールド変更の自動ログ
/// NOTE: 手動メモ
/// EXPENSE_ADDED/DELETED: 経費の追加・削除ログ
model ProjectLog {
  id        String         @id @default(cuid())
  type      ProjectLogType @default(NOTE)
  content   String         @db.Text
  staffName String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
  @@map("project_logs")
}

// ==============================================================
// RevenueReport（売上報告）
// ==============================================================

/// 月次売上報告。MANAGER 以上が自拠点のデータのみ登録・閲覧できる。
/// amount は税抜金額。targetMonth は計上月の月初日（YYYY-MM-01）で保存。
model RevenueReport {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(15, 0) // 売上金額（税抜）
  targetMonth DateTime // 計上月（月初日 YYYY-MM-01 で保存）
  memo        String?  @db.Text // 備考

  // ---- 月次報告フィールド ------------------------------------
  projectName       String? // 関連プロジェクト名（自由入力）
  staffName         String? // 今の状況（選択値）
  currentProjects   Int? // 今月の案件数
  nextMonthProjects Int? // 来月の見込み案件数
  supportRequest    String? // 本部に相談したいこと（選択値）

  // ---- 作成者（データ保護の軸）--------------------------------
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  // ---- マルチテナント（必須）-----------------------------------
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([targetMonth])
  @@index([createdById])
  @@map("revenue_reports")
}

// ==============================================================
// InvoiceRequest（請求依頼）
// ==============================================================

/// 本部へ提出する請求依頼。
/// 作成者本人と ADMIN（本部）のみが閲覧・操作できる。
model InvoiceRequest {
  id String @id @default(cuid())

  // ── 請求情報
  subject      String // 件名
  branchLabel  String? // 拠点ラベル（複数拠点パートナーの場合、この請求がどの県の売上か）。県別ロイヤリティ判定に使用
  contactName  String? // 請求先担当者名
  contactEmail String // 請求先担当者メールアドレス（必須）
  billingDate  DateTime // 請求日
  dueDate      DateTime? // 支払期限
  details      String?   @db.Text // 内訳

  // ── 金額（10%税計算結果も保存）
  amountExclTax Decimal @db.Decimal(15, 0) // 税抜金額
  taxAmount     Decimal @db.Decimal(15, 0) // 消費税額（10%）
  amountInclTax Decimal @db.Decimal(15, 0) // 税込金額

  // ── 検収・添付
  inspectionStatus String? // 検収状況
  fileUrl          String? // 請求書PDF URL
  notes            String? @db.Text // 備考

  // ── 内訳（媒体費 / 制作費）
  mediaExpense      Decimal? @db.Decimal(15, 0) // 媒体費（税抜・源泉対象外）
  productionExpense Decimal? @db.Decimal(15, 0) // 制作費（税抜・源泉対象）

  // ── 源泉徴収・インボイス
  withholdingTaxAmount   Decimal? @db.Decimal(15, 0) // 源泉徴収税額
  nonDeductibleTaxAmount Decimal? @db.Decimal(15, 0) // 控除不可消費税額
  netPaymentAmount       Decimal? @db.Decimal(15, 0) // 差引支払額

  // ── ステータス
  status        InvoiceRequestStatus @default(DRAFT)
  paymentStatus PaymentStatus        @default(UNPAID)
  paidAt        DateTime?

  // ── プロジェクト紐付け（任意）
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // ── 請求先顧客（CustomerテーブルのFK）
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // ── 作成者（データ保護の主軸）
  createdById  String
  createdBy    User   @relation(fields: [createdById], references: [id])
  creatorEmail String // 通知用（非正規化）

  // ── マルチテナント
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- 支払明細リレーション ----
  paymentStatements PaymentStatement[]

  @@index([branchId])
  @@index([createdById])
  @@index([status])
  @@index([projectId])
  @@index([customerId])
  // 複合インデックス: 自分の依頼を最新順で取得（一覧の主要クエリ）
  @@index([createdById, createdAt(sort: Desc)])
  @@map("invoice_requests")
}

// ==============================================================
// PaymentStatement（支払明細書）
// ==============================================================

/// 本部 → パートナーへの支払明細。
/// クライアントからの入金に対して、手数料・源泉徴収・控除不可消費税を差し引いた
/// パートナーへの支払額を明細として管理する。
model PaymentStatement {
  id String @id @default(cuid())

  // ── 支払先パートナー
  groupCompanyId String
  groupCompany   GroupCompany @relation(fields: [groupCompanyId], references: [id], onDelete: Cascade)

  // ── 元の請求依頼（任意リンク）
  invoiceRequestId String?
  invoiceRequest   InvoiceRequest? @relation(fields: [invoiceRequestId], references: [id], onDelete: SetNull)

  // ── 明細情報
  title       String // 件名（例: ○○案件 支払明細）
  clientName  String? // クライアント名（参照用）
  branchLabel String? // 拠点ラベル（複数拠点パートナーの場合、この入金がどの県の売上か）。県別ロイヤリティ判定に使用
  description String? @db.Text // 備考

  // ── 金額
  grossAmount       Decimal @db.Decimal(15, 0) // クライアントからの入金額（税込）
  commissionRate    Decimal @default(10) @db.Decimal(5, 2) // 本部手数料率（%）
  commissionAmount  Decimal @db.Decimal(15, 0) // 本部手数料額
  mediaExpense      Decimal @default(0) @db.Decimal(15, 0) // 媒体費（税抜・パススルー）
  productionExpense Decimal @default(0) @db.Decimal(15, 0) // 制作費（税抜）

  // ── 税額調整
  withholdingTaxAmount   Decimal @default(0) @db.Decimal(15, 0) // 源泉徴収税額
  nonDeductibleTaxAmount Decimal @default(0) @db.Decimal(15, 0) // 控除不可消費税額
  netPaymentAmount       Decimal @db.Decimal(15, 0) // 差引支払額

  // ── ステータス
  status PaymentStatementStatus @default(DRAFT)
  paidAt DateTime?

  // ── 作成者
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── クライアント別明細行（複数クライアントを1明細にまとめる場合）
  items PaymentStatementItem[]

  @@index([groupCompanyId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("payment_statements")
}

// ==============================================================
// PaymentStatementItem（支払明細のクライアント別行）
// ==============================================================

/// 1枚の支払明細に複数クライアント分の入金をまとめる際の明細行。
/// 手数料率・媒体費・制作費・各種税は親 PaymentStatement 側で合計管理し、
/// この行はクライアントごとの入金額（税込）の内訳を保持する。
/// 行が無い明細は従来どおり親の clientName / grossAmount を単一クライアントとして扱う。
model PaymentStatementItem {
  id                 String           @id @default(cuid())
  paymentStatementId String
  paymentStatement   PaymentStatement @relation(fields: [paymentStatementId], references: [id], onDelete: Cascade)

  clientName  String // クライアント名
  grossAmount Decimal @db.Decimal(15, 0) // そのクライアントからの入金額（税込）
  note        String? // 補足（案件名など）
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())

  @@index([paymentStatementId])
  @@map("payment_statement_items")
}

// ==============================================================
// GroupInvoice（グループ請求書：本部 → パートナーへ請求）
// ==============================================================

/// 本部 → パートナーへ発行する適格請求書。
/// 月額ロイヤリティは「最低保証型」: 当月の案件由来 本部手数料(10%) 合計が
/// 最低ロイヤリティ(5万)に満たない場合のみ、その差額を請求する。
/// 10% が 5万 以上の代表（取扱高 約50万以上）は相殺済みのため請求書を発行しない。
/// 振込先は Ad Arch 自社口座（theme.ts の BILLING_ACCOUNTS）。
model GroupInvoice {
  id String @id @default(cuid())

  // ── 請求先パートナー
  groupCompanyId String
  groupCompany   GroupCompany @relation(fields: [groupCompanyId], references: [id], onDelete: Cascade)

  // ── 請求書番号（人が読む連番。例: AA-2026-0001）
  invoiceNo String @unique

  // ── 区分・内容
  type        GroupInvoiceType @default(ROYALTY)
  title       String // 件名（例: 2026年5月分 ロイヤリティ）
  targetMonth String? // 対象月（ロイヤリティ用・"2026-05"）
  description String?          @db.Text // 備考

  // ── 金額（税抜本体を起点に消費税10%）
  subtotalExclTax Decimal @db.Decimal(15, 0) // 小計（税抜）
  taxAmount       Decimal @db.Decimal(15, 0) // 消費税（10%）
  totalInclTax    Decimal @db.Decimal(15, 0) // 合計（税込）

  // ── 期日
  issueDate DateTime  @default(now()) // 請求日
  dueDate   DateTime? // 支払期限

  // ── ステータス
  status GroupInvoiceStatus @default(DRAFT)
  paidAt DateTime?

  // ── 作成者
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items GroupInvoiceItem[]

  @@index([groupCompanyId])
  @@index([status])
  @@index([targetMonth])
  @@index([createdAt(sort: Desc)])
  @@map("group_invoices")
}

/// グループ請求書の明細行（税抜単価 × 数量）。
model GroupInvoiceItem {
  id             String       @id @default(cuid())
  groupInvoiceId String
  groupInvoice   GroupInvoice @relation(fields: [groupInvoiceId], references: [id], onDelete: Cascade)

  name      String // 品目（例: 月額ロイヤリティ、加盟参画費用）
  detail    String? // 補足
  quantity  Decimal @default(1) @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(15, 0) // 単価（税抜）
  amount    Decimal @db.Decimal(15, 0) // 金額（税抜）= quantity × unitPrice
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@index([groupInvoiceId])
  @@map("group_invoice_items")
}

/// ロイヤリティ相殺の手入力調整。
/// 支払明細の自動集計を上書きする「その月・その県の手数料相当額（相殺額）」。
/// branchLabel="" は単一拠点（パートナー全体）。複数拠点は県ごとに1行。
model RoyaltyAdjustment {
  id String @id @default(cuid())

  groupCompanyId String
  groupCompany   GroupCompany @relation(fields: [groupCompanyId], references: [id], onDelete: Cascade)

  month             String // 対象月（"2026-05"）
  branchLabel       String  @default("") // 県名。単一拠点は ""
  commissionExclTax Int     @default(0) // 手入力の相殺額（手数料相当・税抜）
  exempt            Boolean @default(false) // その月の免除（branchLabel="" の行で月全体を免除）
  note              String?

  createdById String // 入力者（監査用・スカラ）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([groupCompanyId, month, branchLabel])
  @@index([groupCompanyId, month])
  @@map("royalty_adjustments")
}

// ==============================================================
// EstimationTemplate（標準単価マスタ）
// ==============================================================

/// 社内の標準単価マスタ。見積作成時のオートコンプリート元データ。
/// スタッフ向けに原価目安（costPrice）を保持するが、PDF には出力しない。
model EstimationTemplate {
  id        String   @id @default(cuid())
  category  String // カテゴリ（例: 企画・進行）
  name      String // 品目・サービス名
  unitPrice Decimal  @db.Decimal(15, 0) // 標準単価（税抜）
  unit      String // 単位（例: 日、式）
  spec      String?  @db.Text // 仕様・提供範囲
  costPrice Decimal? @db.Decimal(15, 0) // 原価目安（スタッフ内部用・PDF非出力）
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("estimation_templates")
}

// ==============================================================
// Estimation（見積書）
// ==============================================================

/// 顧客向けの見積書。複数の EstimationItem を持つ。
model Estimation {
  id           String           @id @default(cuid())
  title        String // 見積タイトル
  status       EstimationStatus @default(DRAFT)
  estimateDate DateTime         @default(now()) // 見積日
  validUntil   DateTime? // 有効期限
  notes        String?          @db.Text // 備考
  staffName    String? // 担当者名

  // ---- 顧客との紐づき（任意）------------------------------------
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // ---- プロジェクトとの紐づき（任意）----------------------------
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // ---- 出精値引き（内部用・PDF非出力）--------------------------
  discountAmount     Decimal? @db.Decimal(15, 0) // 値引き額（税抜・正の数で入力し合計からマイナス）
  discountReason     String? // BUDGET_FIRST | EXISTING | INVESTMENT | OTHER
  discountReasonNote String? // 「その他」の場合の自由記述

  // ---- 作成者メール（通知用・非正規化）------------------------
  createdByEmail String?

  // ---- マルチテナント（必須）------------------------------------
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  items EstimationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([createdByEmail])
  @@map("estimations")
}

// ==============================================================
// EstimationItem（見積明細）
// ==============================================================

/// 見積書の各行明細。マスタから補完されるが独立して編集可能。
model EstimationItem {
  id         String   @id @default(cuid())
  name       String // 品目名
  spec       String?  @db.Text // 仕様・備考
  quantity   Int      @default(1) // 数量
  unit       String? // 単位
  unitPrice  Decimal  @db.Decimal(15, 0) // 単価
  amount     Decimal  @db.Decimal(15, 0) // 金額（数量 × 単価）
  costPrice  Decimal? @db.Decimal(15, 0) // 原価目安（内部用・PDF非出力）
  sortOrder  Int      @default(0)
  templateId String? // 参照元マスタ ID（任意）

  estimationId String
  estimation   Estimation @relation(fields: [estimationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estimationId])
  @@map("estimation_items")
}

// ==============================================================
// WikiArticle（社内Wiki記事）
// ==============================================================

/// 社内Wikiの記事。Markdownで記述・表示される。
model WikiArticle {
  id         String    @id @default(cuid())
  title      String
  body       String    @db.Text
  authorName String
  branchId   String
  branch     Branch    @relation(fields: [branchId], references: [id])
  tags       WikiTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@map("wiki_articles")
}

/// Wikiタグ。記事のカテゴリ分類に使用。
model WikiTag {
  id       String        @id @default(cuid())
  name     String        @unique
  color    String        @default("#8b5cf6")
  articles WikiArticle[]

  @@map("wiki_tags")
}

// ==============================================================
// GroupCollaborationRequest（グループ連携依頼）
// ==============================================================

/// グループ内拠点間の連携依頼。撮影支援・機材手配・知見共有などを管理する。
model GroupCollaborationRequest {
  id              String                   @id @default(cuid())
  projectId       String?
  project         Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  counterpartName String // 連携先代表（相手）
  requestType     CollaborationRequestType
  budget          String? // 希望予算（自由入力）
  description     String                   @db.Text // 依頼内容・条件
  desiredDate     DateTime? // 希望納期・実施日
  attachmentUrl   String? // 添付ファイル URL
  status          CollaborationStatus      @default(PENDING)
  replyNote       String?                  @db.Text // やり取り・回答
  branchId        String?
  branch          Branch?                  @relation(fields: [branchId], references: [id])
  createdById     String?
  createdBy       User?                    @relation(fields: [createdById], references: [id])
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([branchId])
  @@index([createdById])
  @@index([status])
  @@index([projectId])
  // 複合インデックス: 拠点別 + 最新順（一覧取得の主要クエリ）
  @@index([branchId, createdAt(sort: Desc)])
  @@map("group_collaboration_requests")
}

// ==============================================================
// MediaRequest（媒体依頼）
// ==============================================================

/// 媒体広告の掲載依頼。MANAGER以上が申請・管理できる。
model MediaRequest {
  id            String             @id @default(cuid())
  mediaType     MediaType
  mediaName     String // 媒体名（自由入力）
  customerId    String?
  customer      Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  startDate     DateTime? // 掲載開始日
  endDate       DateTime? // 掲載終了日
  budget        String? // 費用・予算（自由入力）
  description   String?            @db.Text
  attachmentUrl String?
  status        MediaRequestStatus @default(PENDING)
  replyNote     String?            @db.Text
  branchId      String?
  branch        Branch?            @relation(fields: [branchId], references: [id])
  createdById   String?
  createdBy     User?              @relation(fields: [createdById], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([branchId])
  @@index([createdById])
  @@index([status])
  @@index([branchId, createdAt(sort: Desc)])
  @@map("media_requests")
}

// ==============================================================
// AdvertiserReview（TVer広告主 業態考査申請）
// ==============================================================

/// TVer広告を出稿する広告主の業態考査申請。
/// 申請者が提出 → 管理者が APPROVED/REJECTED に更新。
/// APPROVED になった広告主のみ、次フェーズの TVer配信申請で選択可能。
model AdvertiserReview {
  id String @id @default(cuid())

  // ── 広告主情報
  name                 String // 広告主様名（必須）
  websiteUrl           String // 企業ページ URL（必須）
  corporateNumber      String?   @db.VarChar(13) // 法人番号（13桁）
  hasNoCorporateNumber Boolean   @default(false) // 法人番号なしフラグ
  productUrl           String // 商材サイト URL（必須）
  desiredStartDate     DateTime? // 広告展開希望日
  remarks              String?   @db.Text // 備考

  // ── 考査ステータス
  status       AdvertiserReviewStatus @default(PENDING)
  reviewNote   String?                @db.Text // 審査コメント（管理者記入）
  reviewedAt   DateTime? // 承認/否決日時
  reviewedById String?
  reviewedBy   User?                  @relation("ReviewedAdvertiserReview", fields: [reviewedById], references: [id])

  // ── 申請者（担当者）
  createdById  String
  createdBy    User   @relation("CreatedAdvertiserReview", fields: [createdById], references: [id])
  creatorEmail String // 通知用（非正規化）

  // ── マルチテナント
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tverCampaigns       TverCampaign[]
  tverCreativeReviews TverCreativeReview[]

  @@index([branchId])
  @@index([createdById])
  @@index([status])
  @@index([branchId, createdAt(sort: Desc)])
  @@map("advertiser_reviews")
}

// ==============================================================
// TverCampaign（TVer配信申請）
// ==============================================================

/// TVer広告の配信申請。
/// 業態考査で APPROVED になった広告主のみ選択可能。
model TverCampaign {
  id String @id @default(cuid())

  // ── 広告主（業態考査承認済みのみ）
  advertiserId String
  advertiser   AdvertiserReview @relation(fields: [advertiserId], references: [id])

  // ── 案件基本情報
  campaignName String // キャンペーン名
  budget       Decimal  @db.Decimal(15, 0) // 広告予算（円・税抜）
  startDate    DateTime // 配信開始日
  endDate      DateTime // 配信終了日

  // ── 予算タイプ
  budgetType TverCampaignBudgetType // 期間予算 / 月次予算

  // ── フリークエンシーキャップ（任意）
  freqCapUnit  TverFrequencyCapUnit? // カウント単位
  freqCapCount Int? // 回数

  // ── コンパニオン AD
  companionMobile TverCompanionMobile @default(NONE)
  companionPc     TverCompanionPc     @default(NONE)

  // ── ターゲティング
  genderTarget TverGenderTarget @default(ALL)
  areas        String[] // 選択されたエリアコード

  // ── URL
  landingPageUrl String? // リンク先 LP URL

  // ── 拡張設定（JSON: デバイス, オーディエンス, コンテンツ, 時間帯配分, フリークエンシー詳細等）
  settings Json?

  // ── 申請ステータス
  status     TverCampaignStatus @default(SUBMITTED)
  reviewNote String?            @db.Text // 管理者コメント

  // ── 申請者（担当者）
  createdById  String
  createdBy    User   @relation(fields: [createdById], references: [id])
  creatorEmail String // 通知用（非正規化）

  // ── マルチテナント
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([createdById])
  @@index([advertiserId])
  @@index([status])
  @@index([branchId, createdAt(sort: Desc)])
  @@map("tver_campaigns")
}

// ==============================================================
// TverCreativeReview（TVer クリエイティブ考査申請）
// ==============================================================

enum TverCreativeReviewStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

/// TVer クリエイティブ（素材）の考査申請。
/// 業態考査で APPROVED になった広告主のみ選択可能。
model TverCreativeReview {
  id String @id @default(cuid())

  // ── 広告主（業態考査承認済みのみ）
  advertiserId String
  advertiser   AdvertiserReview @relation(fields: [advertiserId], references: [id])

  // ── 案件情報
  projectName    String // プロジェクト名
  numberOfAssets Int // 本数
  driveUrl       String // データ格納リンク
  remarks        String? @db.Text // 備考

  // ── 申請ステータス
  status       TverCreativeReviewStatus @default(SUBMITTED)
  reviewNote   String?                  @db.Text // 審査コメント（管理者記入）
  reviewedAt   DateTime? // 承認/否決日時
  reviewedById String?
  reviewedBy   User?                    @relation("ReviewedTverCreativeReview", fields: [reviewedById], references: [id])

  // ── 申請者
  createdById  String
  createdBy    User   @relation(fields: [createdById], references: [id])
  creatorEmail String

  // ── マルチテナント
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([createdById])
  @@index([advertiserId])
  @@index([status])
  @@map("tver_creative_reviews")
}

// ==============================================================
// VideoAchievement — 競合制作会社の実績データ（自動収集）
// ==============================================================

// ==============================================================
// AuditLog（操作ログ）
// ==============================================================

/// 全操作の監査ログ。ログイン・作成・更新・削除を記録し、セキュリティ監査に活用。
model AuditLog {
  id        String   @id @default(cuid())
  action    String // "login_success", "login_failed", "customer_created", "deal_updated" 等
  email     String
  name      String?
  entity    String? // "customer", "deal", "project" 等（ログイン時は null）
  entityId  String? // 対象レコードの ID
  detail    String? // 補足情報（変更内容の要約など）
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([email])
  @@index([action])
  @@map("audit_logs")
}

// ==============================================================
// VideoAchievement — 競合制作会社の実績データ（自動収集）
// ==============================================================

model VideoAchievement {
  id                String   @id @default(cuid())
  companyName       String // ターゲット企業名
  prefecture        String // 都道府県
  industry          String   @default("不明") // 業種
  productionCompany String // 競合制作会社名
  videoType         String   @default("不明") // 動画種別
  referenceUrl      String? // 実績ページURL/YouTube
  contentSummary    String?  @db.Text // AIによる制作内容分析
  sourceUrl         String? // スクレイピング元URL
  publishedAt       String? // 掲載日（例: "2024年3月"）
  isProcessed       Boolean  @default(false) // CRM連携済みフラグ
  createdById       String?
  createdBy         User?    @relation("VideoAchievementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([companyName, productionCompany])
  @@index([prefecture])
  @@index([industry])
  @@index([isProcessed])
  @@map("VideoAchievement")
}

// ==============================================================
// DashboardDigest（ダッシュボードダイジェスト）
// ==============================================================

/// AI生成のグループ活動サマリー。シングルトン（id="singleton"）で管理し、
/// 24時間ごとに再生成される。全ユーザーが同一の内容を閲覧する。
model DashboardDigest {
  id        String   @id @default("singleton")
  content   String // AI生成サマリー（3〜5行テキスト）
  dataJson  String? // 元データJSON（デバッグ用）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dashboard_digests")
}

// ==============================================================
// BusinessCard（名刺管理）
// ==============================================================

/// Eight CSV からインポートした名刺情報。
/// 公開フィールド（会社名・部署・役職など）と秘匿フィールド（メール・個人電話など）を分離し、
/// 秘匿フィールドの閲覧には所有者承認 or ADMIN 権限が必要。
model BusinessCard {
  id String @id @default(cuid())

  // ---- 公開フィールド（全ユーザー閲覧可） ----
  companyName   String // 会社名
  department    String? // 部署
  title         String? // 役職
  lastName      String // 姓
  firstName     String? // 名
  lastNameKana  String? // 姓カナ
  firstNameKana String? // 名カナ
  prefecture    String? // 都道府県
  companyPhone  String? // 会社電話番号
  url           String? // 会社URL
  exchangeDate  DateTime? // 名刺交換日
  tags          String? // タグ（カンマ区切り）
  wantsCollab   Boolean   @default(false) // コラボレーション希望
  isOrdered     Boolean   @default(false) // 受注済み
  isCompetitor  Boolean   @default(false) // 競合
  isCreator     Boolean   @default(false) // 映像クリエイター

  // ---- 地域フラグ（12区分） ----
  regionHokkaido  Boolean @default(false) // 北海道
  regionTohoku    Boolean @default(false) // 東北
  regionKitakanto Boolean @default(false) // 北関東
  regionSaitama   Boolean @default(false) // 埼玉
  regionChiba     Boolean @default(false) // 千葉
  regionTokyo     Boolean @default(false) // 東京
  regionKanagawa  Boolean @default(false) // 神奈川
  regionChubu     Boolean @default(false) // 中部
  regionKansai    Boolean @default(false) // 関西
  regionChugoku   Boolean @default(false) // 中国
  regionShikoku   Boolean @default(false) // 四国
  regionKyushu    Boolean @default(false) // 九州・沖縄

  // ---- AI エンリッチメント ----
  aiIndustry String? // AI判定の業界カテゴリ
  aiSummary  String? @db.Text // AI生成の事業概要
  aiTags     String? // AI生成のタグ（カンマ区切り）

  // ---- 秘匿フィールド（所有者/ADMIN/開示承認者のみ閲覧可） ----
  email           String? // メールアドレス
  directPhone     String? // 直通電話
  mobilePhone     String? // 携帯電話
  fax             String? // FAX
  postalCode      String? @db.VarChar(8) // 郵便番号
  address         String? // 住所（詳細）
  sharedMemoTitle String? // 共有メモタイトル
  exchangePlace   String? // 名刺交換場所
  workHistory     String? @db.Text // 経歴
  personality     String? @db.Text // 人柄メモ
  textMemo        String? @db.Text // テキストメモ

  // ---- 名刺画像 ----
  cardImageUrl String? // Supabase Storage URL

  // ---- 所有者（CSVの「所有者」→ User.name でマッチ） ----
  ownerId String
  owner   User   @relation("OwnedBusinessCards", fields: [ownerId], references: [id])

  // ---- 開示申請 ----
  disclosureRequests DisclosureRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyName, lastName, firstName])
  @@index([ownerId])
  @@index([companyName])
  @@index([aiIndustry])
  @@index([prefecture])
  @@map("business_cards")
}

// ==============================================================
// DisclosureRequest（秘匿情報開示申請）
// ==============================================================

/// 名刺の秘匿フィールドの閲覧を申請するワークフロー。
/// 1名刺につき1ユーザー1件まで（重複防止）。
model DisclosureRequest {
  id String @id @default(cuid())

  businessCardId String
  businessCard   BusinessCard @relation(fields: [businessCardId], references: [id], onDelete: Cascade)

  requesterId String
  requester   User   @relation("DisclosureRequester", fields: [requesterId], references: [id])

  purpose String           @db.Text // 開示目的
  status  DisclosureStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?     @relation("DisclosureReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?   @db.Text
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessCardId, requesterId])
  @@index([businessCardId])
  @@index([requesterId])
  @@index([status])
  @@map("disclosure_requests")
}

// ==============================================================
// AIMatchingCache（AIマッチング結果キャッシュ）
// ==============================================================

/// 企業ごとのAIマッチング結果をキャッシュ。7日TTLで再生成。
model AIMatchingCache {
  id              String   @id @default(cuid())
  companyName     String   @unique
  matchResultJson String   @db.Text // JSON文字列
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("ai_matching_cache")
}

// ==============================================================
// グループサポート（週次共有・フォロー管理）
// ==============================================================

enum GroupCompanyPhase {
  ONBOARDING // 導入期
  GROWING // 成長期
  STABLE // 安定期
  RESTRUCTURING // 立て直し期
}

enum WeeklyStatus {
  GREEN // いい感じ
  YELLOW // ちょっと苦戦
  RED // 手が止まっている
  NONE // 未共有
}

enum ContactType {
  WEEKLY_SUBMISSION // 週次共有（Bot経由）
  FOLLOW_UP // 声かけ（Bot自動）
  CEO_COMMENT // 社長コメント
  MANUAL_NOTE // 手動メモ（ダッシュボード）
}

/// グループ加盟企業マスタ。Google Chat スペースと1対1で紐づく。
model GroupCompany {
  id          String            @id @default(cuid())
  name        String // 企業名
  ownerName   String // 代表者名
  chatSpaceId String            @unique // Google Chat スペース ID
  phase       GroupCompanyPhase @default(ONBOARDING)
  memo        String?           @db.Text // 本部メモ
  isActive    Boolean           @default(true)

  // ---- 加盟内容 ----
  membershipCount   Int      @default(1) // 加盟拠点数（旧・単純倍率）。branchLabels があればそちらが優先
  branchLabels      String[] @default([]) // 複数拠点の県名（例: ["山口","広島"]）。県ごとに独立して最低保証を判定。単一拠点は空
  royaltyMinExclTax Int? // 月額ロイヤリティ最低保証（税抜）。null=既定5万。複数拠点なら各県にこの額を適用
  royaltyExempt     Boolean  @default(false) // ロイヤリティ免除（請求しない）

  // ---- 法人区分・経理情報 ----
  registeredName    String? // 登記名（正式な法人名 or 屋号）
  entityType        EntityType       @default(UNKNOWN) // 法人 / 個人事業主 / 未確認
  corporateNumber   String? // 法人番号（13桁）
  invoiceNumber     String? // インボイス登録番号（T+13桁）
  invoiceRegistered Boolean          @default(false) // インボイス登録済みか
  bankName          String? // 銀行名
  bankBranch        String? // 支店名
  bankAccountType   BankAccountType? // 普通 / 当座
  bankAccountNumber String? // 口座番号
  bankAccountHolder String? // 口座名義

  // ---- 契約管理 ----
  contractEndDate DateTime? // 契約満了日
  contractRenewed Boolean   @default(false) // 次期更新確認済みか

  // ---- プロフィール情報 ----
  emoji        String? // プロフィールアイコン（絵文字）
  genre        String? // ジャンル（営業 / 制作 / 両方 / その他）
  specialty    String? @db.Text // 得意な仕事
  workHistory  String? @db.Text // これまでの仕事
  prefecture   String? // 都道府県
  bio          String? @db.Text // 自己紹介
  twitterUrl   String? // X (Twitter)
  instagramUrl String? // Instagram
  facebookUrl  String? // Facebook
  lineId       String? // LINE ID
  youtubeUrl   String? // YouTube
  tiktokUrl    String? // TikTok
  websiteUrl   String? // Webサイト

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weeklySubmissions    WeeklySubmission[]
  contactHistories     ContactHistory[]
  linkedUsers          User[]                         @relation("UserGroupCompany")
  collaborationMembers CollaborationHighlightMember[]
  postedRequests       ProjectRequest[]               @relation("PostedRequests")
  matchedRequests      ProjectRequest[]               @relation("MatchedRequests")
  applications         ProjectApplication[]           @relation("Applications")
  salesInsights        SalesInsight[]
  salesApproaches      SalesApproach[]

  // ---- 稼働ステータス管理 ----
  partnerStatuses   PartnerStatus[]    @relation("PartnerStatuses")
  partnerStatusLogs PartnerStatusLog[] @relation("PartnerStatusLogs")
  violationReports  ViolationReport[]  @relation("ViolationReporter")
  partnerScores     PartnerScore[]     @relation("PartnerScores")

  // ---- 支払明細 ----
  paymentStatements PaymentStatement[]

  // ---- グループ請求書（本部→当社への請求） ----
  groupInvoices      GroupInvoice[]
  royaltyAdjustments RoyaltyAdjustment[]

  @@index([phase])
  @@map("group_companies")
}

/// 週次共有の回答データ。1企業1週につき1レコード（upsert）。
model WeeklySubmission {
  id             String       @id @default(cuid())
  groupCompanyId String
  groupCompany   GroupCompany @relation(fields: [groupCompanyId], references: [id], onDelete: Cascade)
  weekId         String // ISO週番号（例: "2026-W10"）

  q1 String // 今週の調子は？
  q2 String @db.Text // 先週やったこと
  q3 String @db.Text // 来週やること
  q4 String @db.Text // 共有・相談したいこと
  q5 String // サポートが必要？

  status    WeeklyStatus @default(NONE) // 自動判定
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([groupCompanyId, weekId])
  @@index([weekId])
  @@map("weekly_submissions")
}

/// コンタクト履歴（統一タイムライン）。週次共有・声かけ・社長コメント・手動メモを一元管理。
model ContactHistory {
  id             String       @id @default(cuid())
  groupCompanyId String
  groupCompany   GroupCompany @relation(fields: [groupCompanyId], references: [id], onDelete: Cascade)
  type           ContactType
  content        String       @db.Text // 内容
  actorName      String? // 実行者名（Bot / 社長名 / スタッフ名）
  weekId         String? // 関連する週（任意）

  createdAt DateTime @default(now())

  @@index([groupCompanyId, createdAt(sort: Desc)])
  @@index([weekId])
  @@map("contact_histories")
}

/// 連携案件ハイライト。複数の代表が関わる案件を華やかに表示。
model CollaborationHighlight {
  id          String   @id @default(cuid())
  title       String // 案件タイトル
  description String   @db.Text // 詳細
  emoji       String? // アイコン絵文字
  isActive    Boolean  @default(true) // 表示中フラグ
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members CollaborationHighlightMember[]

  @@map("collaboration_highlights")
}

/// 連携案件とグループ企業の中間テーブル。
model CollaborationHighlightMember {
  id             String                 @id @default(cuid())
  highlightId    String
  highlight      CollaborationHighlight @relation(fields: [highlightId], references: [id], onDelete: Cascade)
  groupCompanyId String
  groupCompany   GroupCompany           @relation(fields: [groupCompanyId], references: [id], onDelete: Cascade)
  role           String? // メンバーの役割（任意）

  @@unique([highlightId, groupCompanyId])
  @@map("collaboration_highlight_members")
}

// ==============================================================
// 案件マッチング
// ==============================================================

enum ProjectRequestStatus {
  OPEN // 募集中
  MATCHED // マッチ済み
  CLOSED // 終了
}

enum ProjectRequestCategory {
  PARTIAL_SALES // 部分営業対応（挨拶）
  SHOOTING // 撮影
  EDITING // 編集
  OTHER // その他
}

enum ProjectFrequency {
  REGULAR // レギュラー
  ONE_TIME // 単発
}

/// 案件マッチング：グループ企業間で案件を紹介し合う。
model ProjectRequest {
  id          String                 @id @default(cuid())
  title       String // 案件名
  description String                 @db.Text // 詳細
  category    ProjectRequestCategory
  prefecture  String? // エリア（都道府県）
  budget      Int? // 予算（税抜・円）
  frequency   ProjectFrequency       @default(ONE_TIME) // レギュラー or 単発
  deadline    DateTime? // 希望納期
  status      ProjectRequestStatus   @default(OPEN)
  isHidden    Boolean                @default(false) // ADMIN非公開フラグ

  postedByCompanyId String
  postedByCompany   GroupCompany @relation("PostedRequests", fields: [postedByCompanyId], references: [id], onDelete: Cascade)
  postedByUserId    String
  postedByUser      User         @relation("PostedRequests", fields: [postedByUserId], references: [id], onDelete: Cascade)

  matchedCompanyId String?
  matchedCompany   GroupCompany? @relation("MatchedRequests", fields: [matchedCompanyId], references: [id])

  applications ProjectApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([postedByCompanyId])
  @@map("project_requests")
}

/// 案件への応募
model ProjectApplication {
  id                 String         @id @default(cuid())
  projectRequestId   String
  projectRequest     ProjectRequest @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  applicantCompanyId String
  applicantCompany   GroupCompany   @relation("Applications", fields: [applicantCompanyId], references: [id], onDelete: Cascade)
  applicantUserId    String
  applicantUser      User           @relation("Applications", fields: [applicantUserId], references: [id], onDelete: Cascade)
  message            String         @db.Text // 一言メッセージ
  contributionScore  Int            @default(0) // 応募時点の貢献度
  isMatched          Boolean        @default(false) // マッチ決定フラグ

  createdAt DateTime @default(now())

  @@unique([projectRequestId, applicantCompanyId])
  @@index([applicantCompanyId])
  @@map("project_applications")
}

// ==============================================================
// Lead（リード）
// ==============================================================

/// リード獲得AIで取得した営業候補企業を管理するテーブル。
/// ステータス管理・担当者アサイン・顧客への転換を行う。
model Lead {
  id                  String        @id @default(cuid())
  name                String
  address             String?
  phone               String?
  rating              Float         @default(0)
  ratingCount         Int           @default(0)
  types               String[]      @default([])
  mapsUrl             String?
  websiteUrl          String?
  businessStatus      String?
  scoreTotal          Int           @default(0)
  scoreBreakdown      Json?
  scoreComment        String?       @db.Text
  industry            String?
  area                String?
  status              LeadStatus    @default(UNTOUCHED)
  memo                String?       @db.Text
  source              LeadSource    @default(GOOGLE_PLACES)
  corporateNumber     String?
  capital             BigInt?
  employeeCount       Int?
  representativeName  String?
  youtubeChannelUrl   String?
  youtubeSubscribers  Int?
  youtubeLastUpload   DateTime?
  subsidies           String[]      @default([])
  cinemaTheaterId     Int?
  cinemaTheaterName   String?
  distanceKm          Float?
  // ---- TVCM/動画PR リード（PR TIMES由来）----
  pressReleaseUrl     String?
  pressReleaseTitle   String?
  videoUrl            String?
  announcedDate       DateTime?
  productionCompany   String?
  prefecture          String?
  agencyDetected      String?
  isListed            Boolean?
  assigneeId          String?
  assignee            User?         @relation("LeadAssignee", fields: [assigneeId], references: [id])
  createdById         String?
  createdBy           User?         @relation("LeadCreatedBy", fields: [createdById], references: [id])
  convertedCustomerId String?       @unique
  convertedCustomer   Customer?     @relation("LeadConvertedCustomer", fields: [convertedCustomerId], references: [id])
  // 声かけ解放: 解放時に直前の担当者名を記録（次の代表が「過去に誰が声かけ済みか」を把握するタグ）
  releasedFromName    String?
  releasedAt          DateTime?
  logs                LeadLog[]
  hearingSheet        HearingSheet?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // ---- Studio（制作OS）----
  studioClients StudioClient[] @relation("StudioLead")

  @@unique([name, address])
  @@index([status])
  @@index([assigneeId])
  @@index([createdAt])
  @@index([source])
  @@map("leads")
}

// ==============================================================
// LeadLog（リード活動ログ）
// ==============================================================

/// リードに対する操作ログ（ステータス変更・メモ・担当者アサインなど）
model LeadLog {
  id        String   @id @default(cuid())
  action    String
  detail    String?  @db.Text
  staffName String
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
  @@map("lead_logs")
}

// ==============================================================
// OutreachSample（営業フォームのマイサンプル＝自作営業文）
// ==============================================================

/// 各ユーザーが営業フォームで使う自作の営業文サンプル。アカウントに紐づきDB保持。
model OutreachSample {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserOutreachSamples", fields: [userId], references: [id], onDelete: Cascade)
  name      String
  text      String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("outreach_samples")
}

// ==============================================================
// HearingSheet（ヒアリングシート）
// ==============================================================

/// 構造化ヒアリングデータ（リード・顧客・商談に紐づく）
model HearingSheet {
  id         String    @id @default(cuid())
  leadId     String?   @unique
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation("CustomerHearingSheets", fields: [customerId], references: [id], onDelete: Cascade)
  dealId     String?   @unique
  deal       Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  // --- A. 顧客理解（WHO） ---
  businessDescription String?  @db.Text /// 事業内容
  targetCustomers     String[] @default([]) /// ターゲット顧客層
  tradeArea           String? /// 商圏
  annualRevenue       String? /// 年商規模
  employeeCount       String? /// 従業員数

  // --- B. 現状把握（NOW） ---
  currentChannels String[] @default([]) /// 現在の集客手段
  monthlyAdBudget String? /// 月間広告費
  pastEfforts     String?  @db.Text /// 過去に試した施策
  competitors     String?  @db.Text /// 競合で気になる会社

  // --- C. 課題・ニーズ（WANT） ---
  primaryChallenge   String? /// 最も解決したい課題
  challengeDetail    String?  @db.Text /// 課題の詳細
  interestedServices String[] @default([]) /// 興味のあるサービス
  desiredTimeline    String? /// 希望開始時期

  // --- D. 意思決定（DECISION） ---
  decisionMaker    String? /// 決裁者
  decisionProcess  String? /// 決裁プロセス
  budgetStatus     String? /// 予算確保状況
  competingVendors String? @db.Text /// 検討中の他社

  // --- E. 動画制作（VIDEO） ---
  videoPurposes     String[]  @default([]) /// 動画の用途
  videoDuration     String? /// 希望する動画の長さ
  videoShootingType String? /// 撮影の有無
  videoCast         String? /// 出演者
  videoReference    String?   @db.Text /// 参考にしたい動画・イメージ
  videoDeadline     DateTime? /// 納品希望日
  videoPublishTo    String[]  @default([]) /// 動画の公開先
  videoBudget       String? /// 予算感（動画制作）

  // --- F. 温度感（TEMPERATURE） ---
  temperature    String? /// 温度感
  nextAction     String?   @db.Text /// 次回アクション
  nextActionDate DateTime? /// 次回予定日

  // --- G. ヒアリング管理 ---
  hearingRound Int? /// ヒアリング何回目か（1=初回, 2=2回目...）
  freeNotes    String? @db.Text /// 自由記載欄

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([customerId])
  @@index([dealId])
  @@map("hearing_sheets")
}

// ==============================================================
// DecisionSheet（決定シート：プロジェクト化確認）
// ==============================================================

/// ヒアリング完了後、プロジェクトとして正式に受注する際の確認シート。
model DecisionSheet {
  id     String @id @default(cuid())
  dealId String @unique
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  // --- 受注内容の確定 ---
  projectName     String?  @db.Text /// 正式プロジェクト名
  confirmedAmount Decimal? @db.Decimal(15, 0) /// 確定金額（円）
  contractType    String? /// 契約形態（spot / monthly / yearly）
  paymentTerms    String?  @db.Text /// 支払条件（例: 納品後30日, 着手金50%）
  deliverables    String?  @db.Text /// 成果物・納品物（改行区切り）

  // --- スケジュール ---
  kickoffDate  DateTime? /// キックオフ日
  deliveryDate DateTime? /// 納品予定日

  // --- 体制 ---
  projectLead String? /// プロジェクトリーダー
  teamMembers String? @db.Text /// チームメンバー（改行区切り）

  // --- 確認事項 ---
  clientApproval   Boolean @default(false) /// クライアント承認済み
  internalApproval Boolean @default(false) /// 社内承認済み
  specialNotes     String? @db.Text /// 特記事項・注意点

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@map("decision_sheets")
}

// ==============================================================
// PortfolioItem（実績フォルダ同期データ）
// ==============================================================

/// Google Drive 実績フォルダの内容を同期したデータ。
/// GAS定期トリガー → API経由でupsertされる。
model PortfolioItem {
  id          String   @id @default(cuid())
  driveFileId String   @unique // Google Drive のファイル/フォルダ ID
  itemType    String // "folder" | "file"
  name        String // ファイル/フォルダ名
  path        String   @db.Text // フルパス（例: "クライアントA / CM制作 / 素材.mp4"）
  mimeType    String // MIMEタイプ
  depth       Int // 階層（0=ルート直下）
  sizeMb      Float    @default(0) // サイズ(MB)
  driveUrl    String // Drive上のURL
  parentName  String? // 親フォルダ名
  lastUpdated DateTime // Drive上の最終更新日
  syncedAt    DateTime @default(now()) // 同期日時

  @@index([itemType])
  @@index([depth])
  @@index([name])
  @@map("portfolio_items")
}

// ==============================================================
// 提案書AI（プロポーザルAI）
// ==============================================================

/// 営業アクティビティ記録。商談・アプローチ・電話・メール等を記録し、
/// 月間の活動件数に基づいて提案書AIの利用権限をアンロックする。
model SalesActivity {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation("SalesActivities", fields: [userId], references: [id], onDelete: Cascade)
  companyName String // 対象企業名
  type        ActivityType @default(OTHER)
  note        String?      @db.Text
  date        DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@index([userId])
  @@index([userId, date])
  @@map("sales_activities")
}

/// AI生成提案書。Claude APIで生成したコンテンツをJSON保存し、PDF出力する。
model Proposal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("Proposals", fields: [userId], references: [id], onDelete: Cascade)
  companyName String // 提案先企業名
  industry    String // 業種
  challenge   String   @db.Text // 課題・ニーズ
  content     Json // 生成されたページコンテンツ
  createdAt   DateTime @default(now())

  // Web提案書フィールド
  slug        String?        @unique // 公開URL用スラッグ（/p/[slug]）
  isPublished Boolean        @default(false) // 公開状態
  publishedAt DateTime? // 公開日時
  title       String? // 公開時の提案書タイトル
  views       ProposalView[] @relation("ProposalViews")

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([slug])
  @@map("proposals")
}

// ==============================================================
// ProposalView（Web提案書 閲覧トラッキング）
// ==============================================================

model ProposalView {
  id          String   @id @default(cuid())
  proposalId  String
  proposal    Proposal @relation("ProposalViews", fields: [proposalId], references: [id], onDelete: Cascade)
  viewerIp    String? // 閲覧者IP（ハッシュ化推奨）
  userAgent   String? // ブラウザ情報
  referrer    String? // 流入元
  duration    Int      @default(0) // 滞在時間（秒）
  scrollDepth Int      @default(0) // スクロール深度（%）
  viewedAt    DateTime @default(now())

  @@index([proposalId])
  @@index([viewedAt(sort: Desc)])
  @@map("proposal_views")
}

// ==============================================================
// SalesInsight（営業インサイト共有）
// ==============================================================

/// 各メンバーがClaudeで分析した営業結果をアップロードする倉庫。
/// グループ全体で「どの業界に何を送って、どんな反応だったか」を共有する。
model SalesInsight {
  id String @id @default(cuid())

  // ---- 投稿者 ----
  groupCompanyId String
  groupCompany   GroupCompany @relation(fields: [groupCompanyId], references: [id], onDelete: Cascade)
  authorName     String // 投稿者名

  // ---- 対象期間 ----
  period String // "2026-03" のような月表記

  // ---- 集計サマリー ----
  totalSent    Int @default(0) // 送信数
  totalReplied Int @default(0) // 返信数

  // ---- Claude分析結果（JSON） ----
  insights     Json @default("[]") // 業種別の分析 [{industry, sent, replied, temperature, summary}]
  topResponses Json @default("[]") // 反応が良かった事例 [{industry, responseSnippet, note}]

  // ---- メモ ----
  memo String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupCompanyId])
  @@index([period])
  @@index([createdAt(sort: Desc)])
  @@map("sales_insights")
}

// ==============================================================
// SalesApproach（営業アプローチ共有）
// ==============================================================

enum SalesApproachResult {
  DEAL // 商談化
  REPLIED_NG // 返信あり（不成立）
  NO_REPLY // 未返信
  REJECTED // 拒否
}

enum SalesApproachMethod {
  EMAIL // メール
  FORM // 問い合わせフォーム
  DM // DM（SNS等）
  PHONE // 電話
  VISIT // 訪問
  OTHER // その他
}

/// グループ内で営業アプローチ（成功・失敗）を共有。
model SalesApproach {
  id String @id @default(cuid())

  // ── 投稿者
  groupCompanyId String
  groupCompany   GroupCompany @relation(fields: [groupCompanyId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation("SalesApproachAuthor", fields: [authorId], references: [id])

  // ── 送り先
  industry   String // 業種
  targetDesc String?   @db.Text // 送り先の特徴（自由記入）
  customerId String? // 顧客管理との紐づけ（任意）
  customer   Customer? @relation("SalesApproachCustomer", fields: [customerId], references: [id])

  // ── アプローチ内容
  method      SalesApproachMethod // 送信方法
  messageBody String              @db.Text // 送信文面

  // ── 結果
  result    SalesApproachResult // 結果
  learnings String?             @db.Text // 学び・振り返り

  createdAt DateTime @default(now())

  @@index([groupCompanyId])
  @@index([result])
  @@index([industry])
  @@index([createdAt(sort: Desc)])
  @@map("sales_approaches")
}

// ==============================================================
// ChatbotConversation（ヘルプチャットボット会話履歴）
// ==============================================================

model ChatbotConversation {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("ChatbotConversations", fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatbotMessage[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("chatbot_conversations")
}

model ChatbotMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String              @db.Text
  createdAt      DateTime            @default(now())

  @@index([conversationId])
  @@map("chatbot_messages")
}

/// システム設定（キーバリュー）。提案書AIのアンロック閾値等を管理。
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ==============================================================
// Ad Arch Studio — 制作OS
// パートナー向けSNS運用・制作ツール
//
// データフロー:
//   Lead → Customer → StudioClient → SNSプラン生成 → 制作物 → 成果データ
//   → 統計 → 営業インサイトに還元
// ==============================================================

enum StudioClientStatus {
  ACTIVE // 運用中
  PAUSED // 一時停止
  CHURNED // 解約
}

enum ProductionType {
  SNS_PLAN // SNS運用プラン（カレンダー+カット表+撮影指示+キャプション+KPI）
  CUTSHEET // カット表単体
  CAPTION // キャプション+ハッシュタグ
  REPORT // 月次レポート
  SHOOTING_GUIDE // 撮影依頼書
  SHORT_VIDEO // ショート動画
  THUMBNAIL // サムネイル/バナー
  SNS_FORMAT_VIDEO // SNSフォーマット自動編集動画
}

enum SnsFormatOrderStatus {
  PENDING // 依頼受付
  UPLOADING // 素材アップロード中
  PROCESSING // 自動編集中（Premiere実行中）
  COMPLETED // 完了
  FAILED // 失敗
}

/// Studio用クライアント。Customerと紐づけ可能（営業→制作の連携）。
/// パートナー（Branch）ごとにクライアントを管理。ヒアリングデータが蓄積され、毎月の生成に再利用される。
model StudioClient {
  id            String             @id @default(cuid())
  name          String // 店舗名・企業名
  businessType  String // 業種
  area          String // エリア
  target        String // ターゲット
  sellingPoints String?            @db.Text // 強み・売り
  snsAccounts   String? // SNSアカウント
  brandColors   String? // ブランドカラー（HEX等）
  logoUrl       String? // ロゴURL
  monthlyBudget Int? // 月額予算
  contractStart DateTime? // 契約開始日
  postsPerMonth Int                @default(12) // 月間投稿数
  status        StudioClientStatus @default(ACTIVE)
  notes         String?            @db.Text

  // ヒアリング蓄積（フリーフォーム。生成時に毎回参照）
  hearingData Json? // 追加ヒアリング情報（JSON）

  // 営業連携
  customerId String? // 既存Customer（経営OS）と紐づけ
  customer   Customer? @relation("StudioCustomer", fields: [customerId], references: [id])
  leadId     String? // リード獲得AIと紐づけ
  lead       Lead?     @relation("StudioLead", fields: [leadId], references: [id])

  // マルチテナント（パートナー別）
  branchId    String
  branch      Branch  @relation("StudioClients", fields: [branchId], references: [id])
  createdById String?
  createdBy   User?   @relation("StudioClientCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  productions     Production[]
  results         MonthlyResult[]
  snsFormatOrders SnsFormatOrder[] @relation("SnsFormatOrders")

  @@index([branchId])
  @@index([customerId])
  @@map("studio_clients")
}

/// 制作物。SNSプラン・カット表・キャプション・レポート等。AIが生成した内容を保存。
model Production {
  id        String         @id @default(cuid())
  type      ProductionType // 種別
  title     String // タイトル（例: "2026年4月 SNS運用プラン"）
  content   String         @db.Text // 生成された内容（Markdown）
  month     String? // 対象月（例: "2026-04"）
  inputData Json? // 生成時の入力パラメータ（再生成用）
  metadata  Json? // トークン数・モデル・生成時間等

  // 紐づけ
  studioClientId String
  studioClient   StudioClient @relation(fields: [studioClientId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation("StudioProductions", fields: [branchId], references: [id])
  createdById    String?
  createdBy      User?        @relation("ProductionCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioClientId])
  @@index([branchId])
  @@index([type])
  @@index([month])
  @@map("studio_productions")
}

/// 月次成果データ。Instagram Insights等の数値を保存。
/// Production（制作物）と同じ月で紐づけることで「何を投稿したら何が起きたか」を分析可能。
model MonthlyResult {
  id    String @id @default(cuid())
  month String // 対象月（例: "2026-04"）

  // Instagram Insights
  followers      Int? // フォロワー数（月末時点）
  followersGain  Int? // フォロワー増減
  reach          Int? // リーチ数
  impressions    Int? // インプレッション数
  engagementRate Float? // エンゲージメント率
  saves          Int? // 保存数
  shares         Int? // シェア数
  profileVisits  Int? // プロフィールアクセス数
  websiteClicks  Int? // ウェブサイトクリック数

  // 投稿別データ（JSON配列）
  postMetrics Json? // [{postId, type, reach, likes, comments, saves, shares}]

  // Google Analytics等
  webSessions   Int? // Webサイトセッション数
  webPageviews  Int? // ページビュー数
  webBounceRate Float? // 直帰率

  // AI分析
  aiSummary     String? @db.Text // AIによる月次サマリー
  aiSuggestions String? @db.Text // AIによる改善提案

  // 生データ保存（再分析用）
  rawData Json? // Instagram Insights/GA等のJSON原本

  // 紐づけ
  studioClientId String
  studioClient   StudioClient @relation(fields: [studioClientId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation("StudioResults", fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studioClientId, month])
  @@index([branchId])
  @@index([month])
  @@map("studio_monthly_results")
}

/// SNSフォーマット自動編集の依頼。カタログから選択→素材アップ→Premiere自動編集→納品。
model SnsFormatOrder {
  id     String               @id @default(cuid())
  status SnsFormatOrderStatus @default(PENDING)

  // フォーマット選択
  formatId   String // カタログのフォーマットID（例: beauty_ba_tru）
  formatName String // フォーマット名（例: ビフォーアフター）
  telopId    String? // テロップスタイルID（例: beauty_after）
  industry   String // 業種
  taste      String // テイスト
  duration   String // 尺（例: 15秒）
  platforms  String // 配信先（例: reel,tiktok,shorts）
  structure  Json // 構成タイムライン（JSONで保存）

  // 素材
  mediaPaths Json? // アップロードされた素材パスの配列
  bgmPath    String? // BGMファイルパス

  // 出力
  outputPath      String? // 書き出し先パス
  thumbnailPath   String? // サムネイルパス
  premiereProject String? // Premiereプロジェクトファイルパス
  errorMessage    String? @db.Text // エラー時のメッセージ

  // 紐づけ
  studioClientId String?
  studioClient   StudioClient? @relation("SnsFormatOrders", fields: [studioClientId], references: [id])
  productionId   String? // 完了後にProductionレコードと紐づけ
  branchId       String
  branch         Branch        @relation("SnsFormatOrders", fields: [branchId], references: [id])
  createdById    String
  createdBy      User          @relation("SnsFormatOrderCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([studioClientId])
  @@index([status])
  @@index([createdById])
  @@map("sns_format_orders")
}

/// 参考動画から解析・生成されたフォーマット。バズ動画の構成を抽出してテンプレート化。
model SnsReferenceFormat {
  id String @id @default(cuid())

  // 元動画情報
  sourceUrl        String // 元動画のURL（Instagram/TikTok等）
  sourceViews      Int? // 元動画の再生数（手動入力）
  sourceDuration   Float? // 元動画の尺（秒）
  sourceResolution String? // 解像度（例: 1080x1920）

  // サムネイル（解析時のフレームキャプチャ）
  thumbnailBase64 String? @db.Text // 代表フレームのbase64 JPEG

  // 解析結果
  title       String // フォーマット名（例: 美容室ビフォーアフター）
  description String? // 説明
  industry    String // 業種
  taste       String // テイスト
  duration    String // 丸めた尺（例: 15秒）
  platforms   String // 配信先（例: reel,tiktok）
  structure   Json // 構成タイムライン
  cutPoints   Json? // カット変化点の秒数配列

  // テロップ分析
  telopAnalysis     Json? // テロップスタイル・配置・色等
  recommendedTelops String? // 推奨テロップID（カンマ区切り）
  hookTechnique     String? // フック技法の説明
  shootingTips      String? // 撮影のコツ

  // メタデータ
  branchId    String
  branch      Branch @relation("SnsReferenceFormats", fields: [branchId], references: [id])
  createdById String
  createdBy   User   @relation("SnsReferenceFormatCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([createdById])
  @@index([industry])
  @@index([createdAt])
  @@map("sns_reference_formats")
}

// ────────────────────────────────────────────────────────────────
// モバイルアプリ プッシュ通知トークン
// ────────────────────────────────────────────────────────────────
model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique // ExponentPushToken[xxx]
  email     String
  platform  String? // ios / android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("push_tokens")
}

// ==============================================================
// Learning System（ラーニングシステム）
// ==============================================================

/// 学習コース。オンボード・媒体別テストなどをまとめる単位。
model LearningCourse {
  id          String               @id @default(cuid())
  title       String
  description String?              @db.Text
  category    String               @default("onboard") // onboard, media, advanced
  sortOrder   Int                  @default(0)
  published   Boolean              @default(false)
  // このコース合格で販売権限が付与される媒体（null = 媒体紐付けなし）
  mediaType   MediaType?
  lessons     LearningLesson[]
  tests       LearningTest[]
  enrollments LearningEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("learning_courses")
}

/// 教材（動画・PDF等）。コース内の学習コンテンツ。
model LearningLesson {
  id          String             @id @default(cuid())
  courseId    String
  course      LearningCourse     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  type        String             @default("video") // video, pdf, text
  contentUrl  String? // HeyGen動画URL or PDFリンク
  body        String?            @db.Text // テキスト教材の場合
  durationMin Int? // 動画の場合の目安時間（分）
  sortOrder   Int                @default(0)
  progress    LearningProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@map("learning_lessons")
}

/// テスト定義。コースに紐づく選択式テスト。
model LearningTest {
  id           String             @id @default(cuid())
  courseId     String
  course       LearningCourse     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  passingScore Int                @default(80) // 合格ライン（%）
  maxAttempts  Int                @default(3) // 最大受験回数
  questions    LearningQuestion[]
  attempts     LearningAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@map("learning_tests")
}

/// テスト問題。選択式。
model LearningQuestion {
  id           String       @id @default(cuid())
  testId       String
  test         LearningTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  question     String       @db.Text
  choices      String       @db.Text // JSON: ["選択肢A","選択肢B","選択肢C","選択肢D"]
  correctIndex Int // 正解のインデックス（0始まり）
  explanation  String?      @db.Text // 解説
  sortOrder    Int          @default(0)

  createdAt DateTime @default(now())

  @@index([testId])
  @@map("learning_questions")
}

/// 受講登録。ユーザーとコースの紐づけ。
model LearningEnrollment {
  id       String         @id @default(cuid())
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   LearningCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status   String         @default("in_progress") // in_progress, completed, frozen

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@map("learning_enrollments")
}

/// 教材の進捗。ユーザーが各レッスンをどこまで見たか。
model LearningProgress {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    LearningLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@map("learning_progress")
}

/// テスト受験記録。スコアと合否を記録。
model LearningAttempt {
  id      String       @id @default(cuid())
  userId  String
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId  String
  test    LearningTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  score   Int // 得点（%）
  passed  Boolean
  answers String       @db.Text // JSON: [選択したインデックスの配列]

  createdAt DateTime @default(now())

  @@index([userId, testId])
  @@map("learning_attempts")
}

// ==============================================================
// Notification（アプリ内通知）
// ==============================================================

enum NotificationType {
  DEAL_WON
  DEAL_UPDATED
  PROJECT_CREATED
  PROPOSAL_VIEWED
  REPORT_SUBMITTED
  REVIEW_MEMBER_ADDED // 映像チェッカーのメンバーに追加された
  REVIEW_CHECK_APPLIED // チェック項目が反映された
  REVIEW_CHECK_CONFIRMED // チェック項目が確認された
  REVIEW_ALL_CHECKED // 全チェック項目完了
  REVIEW_APPROVED // レビューが承認された
  REVIEW_REJECTED // レビューが差し戻された
  SYSTEM
}

model Notification {
  id      String           @id @default(cuid())
  type    NotificationType
  title   String
  message String?          @db.Text
  linkUrl String?
  isRead  Boolean          @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ==============================================================
// お気に入り（ピン留め）
// ==============================================================
model UserFavorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  path      String // e.g. "/dashboard/customers"
  label     String // e.g. "顧客管理"
  icon      String? // icon name for display
  createdAt DateTime @default(now())

  @@unique([userId, path])
  @@index([userId])
  @@map("user_favorites")
}

// ==============================================================
// 映像チェッカー（Video Review）
// ==============================================================

enum VideoReviewStatus {
  UPLOADING
  ANALYZING
  COMPLETED
  FAILED
  APPROVED
  REJECTED
}

enum ChangeType {
  TELOP
  CUT_REPLACE
  COLOR
  DURATION
  ANIMATION
  OTHER
}

model ReviewProject {
  id          String  @id @default(cuid())
  title       String
  description String? @db.Text

  // 案件プロジェクトとの紐付け
  linkedProjectId String?
  linkedProject   Project? @relation(fields: [linkedProjectId], references: [id])

  branchId  String?
  createdBy String
  staffName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews VideoReview[]
  members ReviewProjectMember[]

  @@index([branchId])
  @@index([createdBy])
  @@map("review_projects")
}

// アクセス制御: プロジェクトごとのメンバー
model ReviewProjectMember {
  id        String        @id @default(cuid())
  projectId String
  project   ReviewProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String // User.id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role ReviewMemberRole @default(CHECKER)

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@map("review_project_members")
}

enum ReviewMemberRole {
  OWNER // プロジェクト作成者・最終承認者
  EDITOR // 編集者（反映チェック担当）
  CHECKER // 確認者（ダブルチェック担当）
}

model VideoReview {
  id          String            @id @default(cuid())
  title       String
  description String?           @db.Text
  status      VideoReviewStatus @default(UPLOADING)
  version     Int               @default(1)

  projectId String?
  project   ReviewProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  beforeVideoPath String
  beforeFileName  String
  beforeDuration  Float?
  beforeFps       Float?

  afterVideoPath String
  afterFileName  String
  afterDuration  Float?
  afterFps       Float?

  analysisStartedAt  DateTime?
  analysisFinishedAt DateTime?
  analysisError      String?   @db.Text
  totalChanges       Int       @default(0)

  approvedAt    DateTime?
  approvedBy    String?
  rejectedAt    DateTime?
  rejectedBy    String?
  rejectionNote String?   @db.Text

  branchId  String?
  createdBy String
  staffName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  changes    VideoReviewChange[]
  notes      VideoReviewNote[]
  checkItems ReviewCheckItem[]

  @@index([projectId, version])
  @@index([branchId])
  @@index([status])
  @@index([createdBy])
  @@map("video_reviews")
}

model VideoReviewChange {
  id       String      @id @default(cuid())
  reviewId String
  review   VideoReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  type        ChangeType
  timecodeIn  Float
  timecodeOut Float?
  description String     @db.Text
  confidence  Float      @default(0)

  beforeFramePath String?
  afterFramePath  String?
  diffFramePath   String?

  regionX      Int?
  regionY      Int?
  regionWidth  Int?
  regionHeight Int?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  @@index([reviewId])
  @@map("video_review_changes")
}

model VideoReviewNote {
  id       String      @id @default(cuid())
  reviewId String
  review   VideoReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  timecode Float
  text     String @db.Text
  author   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewId])
  @@map("video_review_notes")
}

// ==============================================================
// 検収チェックリスト
// ==============================================================

// 修正依頼の個別項目
model ReviewCheckItem {
  id       String      @id @default(cuid())
  reviewId String
  review   VideoReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  description String @db.Text // 修正内容（例: 「お届け」→「お届けします」）
  timecode    Float? // 該当タイムコード（秒）
  sortOrder   Int    @default(0)

  // 反映チェック（編集者が確認）
  appliedAt   DateTime?
  appliedBy   String? // staffName
  appliedById String? // User.id

  // 確認チェック（別の人がダブルチェック）
  confirmedAt   DateTime?
  confirmedBy   String? // staffName
  confirmedById String? // User.id

  createdBy String // 登録者 staffName
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewId])
  @@map("review_check_items")
}

// ==============================================================
// 自動営業システム（AutoSales）
// ==============================================================

/// パートナーごとの営業設定。
/// パートナー代表が訴求内容を設定し、本部（ADMIN）承認後に自動送信で使用される。
model AutoSalesTemplate {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  name           String // テンプレート名（例: 美容室向け、工務店向け）
  companyName    String // 送信元会社名
  senderName     String // 送信者名
  phone          String? // 電話番号
  email          String? // メールアドレス
  websiteUrl     String? // Webサイト（署名用、例: https://www.adarch.co.jp）
  position       String? // 役職
  department     String? // 部署
  address        String? // 住所
  additionalInfo String? @db.Text // その他フォームに書き込む補足情報（自由記述）

  // 営業設定（パートナーが入力）
  targetType   AutoSalesTargetType // BtoB / BtoC
  serviceTypes AutoSalesServiceType[] // 訴求カテゴリ（複数選択可）
  pitchText    String                 @db.Text // パートナーが書いた訴求文（自由記述）
  body         String                 @db.Text // 最終的なフォーム送信用本文（pitchTextをベースに生成）

  // スケジュール
  scheduledStartDate DateTime? // 営業開始日（nullなら承認後すぐ開始）

  isApproved Boolean   @default(false) // 本部承認済み
  approvedAt DateTime?
  approvedBy String? // ADMIN User.id

  isFavorite Boolean @default(false) // お気に入り
  isActive   Boolean @default(true) // false=アーカイブ

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs AutoSalesJob[]

  @@index([branchId])
  @@map("auto_sales_templates")
}

/// 営業先企業。パートナーがOS上から投入する。
/// 同一拠点から同一URLへの重複投入を防止。
model AutoSalesTarget {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  companyName String // 営業先企業名
  url         String // 問い合わせフォームURL
  industry    String? // 業種
  area        String? // エリア
  phone       String? // 電話番号（公開情報）
  note        String? @db.Text // メモ

  isFavorite Boolean @default(false) // お気に入り
  isArchived Boolean @default(false) // アーカイブ

  createdById String // 投入した User.id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs AutoSalesJob[]

  @@unique([branchId, url]) // 同一拠点から同一URLへの重複防止
  @@index([branchId])
  @@index([createdById])
  @@map("auto_sales_targets")
}

/// 自動営業の実行ジョブ。1件 = 1フォーム送信。
/// Worker がキューから取り出して順次実行する。
model AutoSalesJob {
  id         String             @id @default(cuid())
  targetId   String
  target     AutoSalesTarget    @relation(fields: [targetId], references: [id], onDelete: Cascade)
  templateId String
  template   AutoSalesTemplate  @relation(fields: [templateId], references: [id])
  status     AutoSalesJobStatus @default(QUEUED)

  // 実行結果
  screenshotUrl String? // 送信前スクリーンショットURL
  filledData    Json? // 実際に入力したフィールド名→値のマップ
  errorMessage  String? @db.Text // エラー時のメッセージ

  // 反響トラッキング
  hasResponse        Boolean   @default(false) // 反響があったか
  responseNote       String?   @db.Text // 反響内容メモ
  responseEmailId    String? // Gmail メッセージID（重複検知用）
  responseFrom       String? // 返信元メールアドレス
  responseSubject    String? // 返信件名
  responseSnippet    String?   @db.Text // 返信本文抜粋
  respondedAt        DateTime? // 反響日時
  chatNotifiedAt     DateTime? // Google Chat通知済み日時
  noReplyConfirmedAt DateTime? // 未返信確定日時（送信3日後に自動設定）
  approachPostedAt   DateTime? // SalesApproachに自動投稿済み日時

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([targetId])
  @@index([templateId])
  @@index([createdAt])
  @@index([hasResponse])
  @@map("auto_sales_jobs")
}

/// 苦情受付・送信拒否リスト。
/// ドメイン単位で管理し、全拠点共通で適用。
model AutoSalesBlacklist {
  id          String  @id @default(cuid())
  domain      String  @unique // 企業ドメイン or URL
  companyName String? // 企業名
  reason      String? @db.Text // 登録理由

  createdAt DateTime @default(now())

  @@map("auto_sales_blacklist")
}

/// 営業プレイブック: 本部が管理する「効果的な訴求パターン」の全社共通テンプレート集。
/// パートナーが Claude Cowork 等で自動営業を行う際の指示書として JSON で取得できる。
model SalesPlaybook {
  id            String   @id @default(cuid())
  label         String // プレイブック名（例: "美容院×動画制作"）
  targetType    String // BTOB / BTOC
  industry      String? // 対象業種
  serviceTypes  String[] // 訴求カテゴリ（VIDEO_PRODUCTION 等）
  pitchTemplate String   @db.Text // 訴求文テンプレート
  approach      String?  @db.Text // 提案タイミング・切り口のコツ
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("sales_playbooks")
}

/// 営業ガイドライン: プレイブック利用時のブランドルール・禁止事項等。
/// key-value 形式で柔軟に格納。
model SalesGuideline {
  id        String   @id @default(cuid())
  key       String   @unique // "brand", "positioning", "tone", "availableMedia", "prohibited"
  value     Json // ガイドライン内容
  updatedAt DateTime @updatedAt

  @@map("sales_guidelines")
}

// ==============================================================
// クリエイター登録プラットフォーム
// 外部クリエイター（カメラマン・エディター・制作）の登録・検索・相談
// ==============================================================

enum CreatorStatus {
  ACTIVE // 通常稼働
  BANNED // BAN（本人に通知）
  SHADOW_BANNED // シャドウBAN（本人に見えない、相談メールが届かない）
  INACTIVE // 退会・非稼働
}

enum SkillLevel {
  BEGINNER // 初級
  INTERMEDIATE // 中級
  ADVANCED // 上級
  EXPERT // エキスパート
}

enum RepeatIntention {
  EXCELLENT // ◎
  GOOD // ○
  FAIR // △
  POOR // ×
}

enum ConsultationStatus {
  DRAFT // 下書き
  SENT // 送信済み
  CLOSED // 終了
}

/// クリエイター本体
model Creator {
  id                      String        @id @default(cuid())
  email                   String        @unique
  name                    String
  entityType              String        @default("individual") // "individual" or "corporation"
  hasBusinessRegistration Boolean       @default(false) // 開業届・事業届出の有無
  nameKana                String?
  phone                   String?
  prefecture              String // 活動拠点（都道府県）
  city                    String? // 市区町村
  companyName             String? // 屋号・法人名
  website                 String? // ポートフォリオサイトURL
  bio                     String?       @db.Text // 自己PR
  profileImage            String? // プロフィール画像URL
  yearsOfExp              Int? // 経験年数
  dayRate                 Int? // 日額単価（円）参考価格
  halfDayRate             Int? // 半日単価（円）
  availability            Int? // 月間稼働可能日数
  equipment               String?       @db.Text // 所有機材（自由記述）
  interestedInPartnership Boolean       @default(false) // グループ加盟への興味
  emailVerified           Boolean       @default(false) // メール認証済みか
  status                  CreatorStatus @default(ACTIVE)

  // OTP認証用
  otpCode      String?
  otpExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  skills                 CreatorSkill[]
  portfolios             CreatorPortfolio[]
  ndaAgreement           CreatorNda?
  ratings                CreatorRating[]
  analysis               CreatorAnalysis?
  consultationRecipients ConsultationRecipient[]
  favorites              CreatorFavorite[]

  @@index([status])
  @@index([prefecture])
  @@map("creators")
}

/// スキルカテゴリマスタ
model SkillCategory {
  id    String @id @default(cuid())
  name  String @unique // 撮影, 編集, モーショングラフィックス, etc.
  order Int    @default(0)

  skills CreatorSkill[]

  @@map("skill_categories")
}

/// クリエイター × スキル（多対多 + レベル）
model CreatorSkill {
  id         String        @id @default(cuid())
  creatorId  String
  creator    Creator       @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  categoryId String
  category   SkillCategory @relation(fields: [categoryId], references: [id])
  level      SkillLevel
  note       String? // 補足（得意ジャンル、使用ソフト等）

  @@unique([creatorId, categoryId])
  @@index([categoryId])
  @@map("creator_skills")
}

/// ポートフォリオ（動画リンク）
model CreatorPortfolio {
  id          String  @id @default(cuid())
  creatorId   String
  creator     Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  url         String // YouTube / Vimeo URL
  title       String?
  description String? @db.Text
  order       Int     @default(0)

  createdAt DateTime @default(now())

  @@index([creatorId])
  @@map("creator_portfolios")
}

/// NDA（守秘義務契約）デジタル署名
model CreatorNda {
  id            String   @id @default(cuid())
  creatorId     String   @unique
  creator       Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  agreedAt      DateTime @default(now())
  ipAddress     String
  userAgent     String?  @db.Text
  ndaVersion    String   @default("1.0")
  signatureHash String // SHA-256 hash of "name|email|timestamp"

  @@map("creator_ndas")
}

/// 裏評価（ADMIN限定、クリエイターには非公開）
model CreatorRating {
  id                 String          @id @default(cuid())
  creatorId          String
  creator            Creator         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  personality        Int // 人柄 1-5
  actualSkill        Int // スキル実力 1-5
  responseSpeed      Int // レスポンス速度 1-5
  deadlineCompliance Int // 納期遵守 1-5
  repeatIntention    RepeatIntention // リピート意向 ◎○△×
  videoInterviewed   Boolean         @default(false) // TV会議面接実施済み
  interviewedBy      String? // 面接担当者名
  notes              String?         @db.Text
  ratedById          String // 評価者のUser ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@map("creator_ratings")
}

/// Web自動分析結果（登録時にスクレイピング→AI解析）
model CreatorAnalysis {
  id        String  @id @default(cuid())
  creatorId String  @unique
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  // 制作実績リスト（構造化JSON）
  // [{title, category, clientScale, thumbnailUrl, url}]
  works Json? @db.JsonB

  // AI推定データ
  genres        String[] // 制作ジャンル: ["企業VP", "CM", "MV", "SNS広告"]
  clientScale   String? // 主要クライアント規模感: "大手" / "中堅" / "地方中小"
  estimatedRate Int? // AI推定日額単価（円）
  priceRange    String? // 価格帯: "低(〜2万)" / "中(2-5万)" / "高(5万〜)"
  equipmentList String[] // 検出機材: ["RED KOMODO", "DJI Mavic 3"]
  snsFollowers  Json?     @db.JsonB // {"youtube": 1200, "instagram": 5000}
  lastWorkDate  DateTime? // 最新実績の日付（活動アクティブ度）
  activityScore Int? // 活動スコア 1-100

  // スクレイピングメタ
  scrapedAt    DateTime?
  scrapeStatus String? // "success" / "failed" / "pending"
  rawHtml      String?   @db.Text // デバッグ用（必要なら）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("creator_analyses")
}

/// プロジェクト相談
model ProjectConsultation {
  id          String             @id @default(cuid())
  title       String
  description String?            @db.Text
  area        String? // 対象エリア
  skillFilter String? // スキルカテゴリ（カンマ区切り）
  budgetRange String? // 予算感
  shootDate   String? // 撮影予定日
  status      ConsultationStatus @default(DRAFT)
  sendMode    String? // "bulk" / "individual"
  sentAt      DateTime?
  sentById    String? // 送信者のUser ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients ConsultationRecipient[]

  @@map("project_consultations")
}

/// 相談 × クリエイター（送信先+ステータス管理）
model ConsultationRecipient {
  id             String              @id @default(cuid())
  consultationId String
  consultation   ProjectConsultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  creatorId      String
  creator        Creator             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  emailSentAt    DateTime?
  opened         Boolean             @default(false) // メール開封
  responded      Boolean             @default(false) // 応諾/辞退
  responseNote   String?             @db.Text

  @@unique([consultationId, creatorId])
  @@index([creatorId])
  @@map("consultation_recipients")
}

/// お気に入りクリエイター（ユーザーごと）
model CreatorFavorite {
  id        String   @id @default(cuid())
  userId    String
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, creatorId])
  @@index([userId])
  @@map("creator_favorites")
}

// ==============================================================
// パートナー稼働ステータス管理
// ==============================================================

enum PartnerStatusType {
  ACTIVE // 稼働中
  INACTIVE // 活動休止中（自己申告）
  FORCED_INACTIVE // 活動休止中（報告ゼロ2ヶ月で強制切替）
  NOT_SELECTED // 未選択
}

/// 認定パートナーの月次稼働ステータス。
/// GroupCompany（加盟企業）ごとに毎月1レコード。
model PartnerStatus {
  id             String            @id @default(cuid())
  groupCompanyId String
  groupCompany   GroupCompany      @relation("PartnerStatuses", fields: [groupCompanyId], references: [id], onDelete: Cascade)
  year           Int // 対象年（例: 2026）
  month          Int // 対象月（1-12）
  status         PartnerStatusType @default(NOT_SELECTED)
  selectedAt     DateTime? // ステータス選択日時（未選択はnull）
  reportCount    Int               @default(0) // 当月報告件数（月次+週次+OS記載）
  note           String?           @db.Text // 備考（「自社案件対応中」等の自由記述）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupCompanyId, year, month])
  @@index([year, month])
  @@index([status])
  @@map("partner_statuses")
}

/// パートナーステータス変更履歴。全変更を追跡。
model PartnerStatusLog {
  id             String            @id @default(cuid())
  groupCompanyId String
  groupCompany   GroupCompany      @relation("PartnerStatusLogs", fields: [groupCompanyId], references: [id], onDelete: Cascade)
  fromStatus     PartnerStatusType
  toStatus       PartnerStatusType
  reason         String // "自己申告" / "報告ゼロ2ヶ月による強制切替" / "ADMIN操作" / "月初リセット"
  changedBy      String // "SYSTEM" / "ADMIN" / パートナーのメールアドレス

  createdAt DateTime @default(now())

  @@index([groupCompanyId, createdAt(sort: Desc)])
  @@map("partner_status_logs")
}

// ==============================================================
// 違反通報（匿名可）
// ==============================================================

enum ViolationReportStatus {
  PENDING // 未対応
  REVIEWING // 調査中
  CONFIRMED // 違反確認
  DISMISSED // 該当なし
  RESOLVED // 対応済み
}

/// パートナーからの違反通報。匿名可。
model ViolationReport {
  id                String                @id @default(cuid())
  reporterCompanyId String? // 通報元（匿名の場合はnull）
  reporterCompany   GroupCompany?         @relation("ViolationReporter", fields: [reporterCompanyId], references: [id], onDelete: SetNull)
  isAnonymous       Boolean               @default(true) // 匿名フラグ
  targetDescription String                @db.Text // 通報対象の説明（「X上で○○と名乗る人物が…」等）
  content           String                @db.Text // 詳細内容
  evidenceUrls      String[] // 証拠URL（スクショのストレージURL等）
  status            ViolationReportStatus @default(PENDING)
  adminNote         String?               @db.Text // ADMIN対応メモ

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("violation_reports")
}

// ==============================================================
// パートナー評価スコア（契約更新時の自動評価用）
// ==============================================================

/// パートナー月次スコアのスナップショット。案件優先度・更新評価に使用。
model PartnerScore {
  id                String       @id @default(cuid())
  groupCompanyId    String
  groupCompany      GroupCompany @relation("PartnerScores", fields: [groupCompanyId], references: [id], onDelete: Cascade)
  year              Int
  month             Int
  reportSubmitRate  Float        @default(0) // 報告提出率（0.0〜1.0）
  revenueAmount     Decimal      @default(0) @db.Decimal(15, 0) // 当月売上
  consecutiveActive Int          @default(0) // 連続稼働月数
  warningCount      Int          @default(0) // 累計警告回数
  totalScore        Float        @default(0) // 総合スコア（0〜100）

  createdAt DateTime @default(now())

  @@unique([groupCompanyId, year, month])
  @@index([totalScore(sort: Desc)])
  @@map("partner_scores")
}

// ==============================================================
// FranchiseLead（加盟リード管理 — ADMIN専用）
// ==============================================================

enum FranchiseLeadStatus {
  NEW
  CONTACTED
  INTERESTED
  MEETING_SCHEDULED
  MEETING_DONE
  NEGOTIATING
  CONTRACTED
  REJECTED
  NOT_FIT
}

/// 加盟候補企業のリード管理。白川代表（ADMIN）のみアクセス可能。
/// 既存の Lead モデルとは完全に分離。
model FranchiseLead {
  id            String  @id @default(cuid())
  companyName   String
  address       String
  prefecture    String?
  phone         String?
  website       String?
  email         String? // 初回コンタクト送付先（任意。Places検索では取得不可のため手入力 or サイトから補完）
  googleMapsUrl String?
  rating        Float?
  reviewCount   Int?
  businessType  String? // 映像制作, 広告代理店, Web制作, 印刷, 営業会社 等

  // AI分析結果
  scoreTotal     Int?
  scoreBreakdown Json?
  scoreComment   String?
  aiAdvice       String? @db.Text // 営業アプローチ提案

  // 営業メール下書き（コックピット）
  emailSubject   String?
  emailBody      String?   @db.Text
  emailDraftedAt DateTime?

  // Web/SNS分析
  hasWebsite       Boolean @default(false)
  hasYoutube       Boolean @default(false)
  hasSns           Boolean @default(false)
  employeeEstimate String?

  // ステータス管理
  status         FranchiseLeadStatus @default(NEW)
  priority       String? // S, A, B, C
  notes          String?             @db.Text
  contactedAt    DateTime?
  nextAction     String?
  nextActionDate DateTime?

  // インバウンド管理（LP問い合わせフォーム等からの自動起票）
  // OUTBOUND=発掘リード（既存） / LP_FORM=加盟LPフォーム / WINDOW=フランチャイズの窓口
  // LP_FORM は個人の問い合わせのため companyName=氏名, address=メールアドレス（@@unique の重複防止キーとして流用）
  source       String  @default("OUTBOUND")
  revenueRange String? // 年商規模（LPフォーム回答。経済力判定をリード化段階で行うため独立カラム）

  // SLA監視（/api/cron/franchise-sla が更新。同一ステージの通知は24hに1回まで）
  slaAlertStage  String?
  slaLastAlertAt DateTime?

  // 担当者（誰が拾ったリードか）。null = 本部（既存リード含む）。
  // 非ADMINは自分が担当のリードのみ閲覧・編集可。emailで識別（session.user.id 非提供のため）。
  ownerEmail String?
  ownerName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyName, address])
  @@index([status])
  @@index([prefecture])
  @@index([priority])
  @@index([ownerEmail])
  @@index([source])
  @@index([createdAt(sort: Desc)])
  @@map("franchise_leads")
}

enum CreatorLeadStatus {
  NEW
  CONTACTED
  INTERESTED
  MEETING_SCHEDULED
  MEETING_DONE
  NEGOTIATING
  CONTRACTED
  REJECTED
  NOT_FIT
}

/// クリエイター発掘AI のリード。白川代表（ADMIN）のみアクセス可能。個人クリエイター（クリエイター加盟プラン候補）用。
/// 既存の FranchiseLead（企業）/ Lead とは完全に分離。
model CreatorLead {
  id           String  @id @default(cuid())
  name         String // 氏名 or 屋号
  handle       String? // ハンドル名・通称
  prefecture   String?
  genre        String? // 動画 / デザイン / Web / 写真 等
  skills       String? // スキル・得意領域
  achievements String? @db.Text // 実績メモ

  // ── リンク（公開連絡先のみ）
  portfolioUrl String? // Vook / foriio / 個人サイト
  websiteUrl   String?
  youtubeUrl   String?
  instagramUrl String?
  xUrl         String?
  tiktokUrl    String?
  email        String?

  // ── AI分析（クリエイター加盟プラン適合）
  scoreTotal   Int?
  scoreComment String? @db.Text
  fitReason    String? @db.Text // クリエイター加盟プラン適合理由
  aiAdvice     String? @db.Text // アプローチ提案

  // ── ステータス
  status         CreatorLeadStatus @default(NEW)
  priority       String? // S, A, B, C
  notes          String?           @db.Text
  contactedAt    DateTime?
  nextAction     String?
  nextActionDate DateTime?

  ownerEmail String?
  ownerName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, portfolioUrl])
  @@index([status])
  @@index([prefecture])
  @@index([createdAt(sort: Desc)])
  @@map("creator_leads")
}

enum OutreachStatus {
  NEW // 未着手
  DRAFTED // 下書き作成済
  SENT // 送信済（人が送った）
  REPLIED // 返信あり
  MEETING // 商談化
  OPTOUT // 配信停止
  DEAD // 見込みなし
}

/// 半自動アウトリーチ（TVer/映像制作・一般企業向け）のリード。
/// AIがパーソナライズ下書きを生成→人がGmailで確認して送信（自動送信はしない）。
model OutreachLead {
  id           String  @id @default(cuid())
  companyName  String
  contactName  String?
  email        String?
  website      String?
  prefecture   String?
  businessNote String? @db.Text // パーソナライズ用の事業メモ

  // ── AI下書き
  draftSubject String?
  draftBody    String?   @db.Text
  draftedAt    DateTime?

  // ── 進捗
  status      OutreachStatus @default(NEW)
  senderEmail String? // 担当（送る人）
  sentAt      DateTime?
  repliedAt   DateTime?
  notes       String?        @db.Text

  ownerEmail String?
  ownerName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ownerEmail])
  @@index([createdAt(sort: Desc)])
  @@map("outreach_leads")
}

/// アウトリーチの配信停止リスト（特電法対応）。ここにあるメールには二度と送らない。
model OutreachOptOut {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@map("outreach_opt_outs")
}

/// AI/外部API の利用ログ。checkRateLimit 通過時に1件記録（誰が・どの機能を・いつ）。
/// API消費の多いユーザーを把握するための軽量ログ。
model ApiUsageLog {
  id        String   @id @default(cuid())
  email     String // 利用者（rate-limit の userId＝メール）
  feature   String // エンドポイントキー（例: creator-leads/search）
  createdAt DateTime @default(now())

  @@index([email])
  @@index([feature])
  @@index([createdAt(sort: Desc)])
  @@map("api_usage_logs")
}

// ==============================================================
// 商談予約システム（TimeRex的機能）
//   - 公開予約ページ（認証不要）から面談を予約
//   - 複数ホストの Google カレンダー freebusy を統合し、
//     空いているホストへ priority 順で自動アサイン
//   - マルチテナント前提: Phase 1 は加盟面談（本部チーム）のみ、
//     Phase 2 で各代表へ展開する
// ==============================================================

enum BookingStatus {
  CONFIRMED // 確定
  CANCELLED // キャンセル済み
}

/// 予約を受けるホスト（カレンダー接続者）。OSユーザーである必要はない（社外パートナー可）
model BookingHost {
  id                 String            @id @default(cuid())
  name               String
  email              String            @unique // 通知先メール
  priority           Int               @default(100) // 小さいほど優先（両者空きの場合のアサイン先）
  isActive           Boolean           @default(true)
  calendarId         String            @default("primary")
  googleEmail        String? // OAuth接続したGoogleアカウント
  googleRefreshToken String?           @db.Text // AES-256-GCM 暗号化済み
  connectToken       String?           @unique // カレンダー接続招待リンク用トークン
  connectedAt        DateTime?
  bookingTypes       BookingTypeHost[]
  bookings           Booking[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@map("booking_hosts")
}

/// 予約タイプ（例: 加盟面談60分）。公開URL: /book/[slug]
model BookingType {
  id              String            @id @default(cuid())
  slug            String            @unique
  title           String
  description     String?           @db.Text
  durationMinutes Int               @default(60)
  slotStepMinutes Int               @default(30) // スロット刻み
  bufferMinutes   Int               @default(15) // 既存予定の前後バッファ
  minNoticeHours  Int               @default(24) // 直前予約の禁止時間
  maxDaysAhead    Int               @default(14) // 何日先まで公開するか
  businessHours   Json // {"days":[1,2,3,4,5],"start":"10:00","end":"18:00"} JST
  questions       Json // [{id,label,type:"text"|"textarea"|"select",options?,required}]
  isActive        Boolean           @default(true)
  hosts           BookingTypeHost[]
  bookings        Booking[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("booking_types")
}

model BookingTypeHost {
  id            String      @id @default(cuid())
  bookingTypeId String
  bookingType   BookingType @relation(fields: [bookingTypeId], references: [id], onDelete: Cascade)
  hostId        String
  host          BookingHost @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([bookingTypeId, hostId])
  @@map("booking_type_hosts")
}

/// 予約レコード。確定時に担当ホストのカレンダーへ Meet 付きイベントを作成し、
/// Lead + LeadLog(BOOKING_CONFIRMED) にも自動反映する
model Booking {
  id            String        @id @default(cuid())
  bookingTypeId String
  bookingType   BookingType   @relation(fields: [bookingTypeId], references: [id])
  hostId        String
  host          BookingHost   @relation(fields: [hostId], references: [id])
  status        BookingStatus @default(CONFIRMED)
  startAt       DateTime
  endAt         DateTime
  name          String // 申込者名
  company       String?
  email         String
  phone         String?
  answers       Json? // スクリーニング質問への回答 [{label,value}]
  googleEventId String?
  meetUrl       String?
  cancelToken   String        @unique @default(cuid())
  cancelledAt   DateTime?
  leadId        String? // 作成した Lead への参照（リレーションは張らない）
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([startAt])
  @@index([hostId, status])
  @@map("bookings")
}
